<Window x:Class="TestWPFControls.Controls.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
                xmlns:local="clr-namespace:TestWPFControls.Controls"
                xmlns:uc="clr-namespace:IPSViewComponentLibraryWPF.Controls.SearchControl;assembly=IPSViewComponentLibraryWPF"
                xmlns:m="clr-namespace:IPSModulesLibrary.RightholdersList;assembly=IPSModulesLibrary"
                Title="MainWindow" Height="600" Width="900">
    <Window.WindowStartupLocation>CenterScreen</Window.WindowStartupLocation>

    <Window.DataContext>
        <local:DefaultViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="t:RadGridView">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="ShowGroupPanel" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsFilteringAllowed" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <m:RightholdersListControl/>
    </Grid>
</Window>
