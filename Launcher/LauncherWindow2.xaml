<Window x:Class="Launcher.LauncherWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        Title="LauncherWindow2" Height="762.865" Width="1523.258"
        Background="#f8f8f8">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0"  Background="#ffffff">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid HorizontalAlignment="Left"  Width="auto" Grid.Row="0">
                    <Image Source="Images/logo1.png" Margin="80,20"/>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" >
                <WrapPanel  VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Width="296" Margin="16 50">
                        <StackPanel  Orientation="Horizontal" Margin="0 0 0 16">
                            <Image Source="Images/Rights.png" Width="80" Height="80" Margin="0 0 24 0"/>
                            <TextBlock VerticalAlignment="Center" FontSize="14px" FontWeight="Bold" Foreground="#D3417F">ПРАВА</TextBlock>
                        </StackPanel>
                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFDEEEB" Offset="0.153" />
                                    <GradientStop Color="#fbf0f5" Offset="0.949" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Правовласники та об’єкти прав</TextBlock>
                        </Border>

                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFDEEEB" Offset="0.153" />
                                    <GradientStop Color="#fbf0f5" Offset="0.949" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Обробка звітів користувачів (індентифікація)</TextBlock>
                        </Border>

                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFDEEEB" Offset="0.153" />
                                    <GradientStop Color="#fbf0f5" Offset="0.949" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Управління технологічнимим процесами</TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Width="296" Margin="16 50">
                        <StackPanel  Orientation="Horizontal" Margin="0 0 0 16">
                            <Image Source="Images/Users.png" Width="80" Height="80" Margin="0 0 24 0"/>
                            <TextBlock VerticalAlignment="Center" FontSize="14px" FontWeight="Bold"  Foreground="#842EF6">КОРИСТУВАЧІ</TextBlock>

                        </StackPanel>
                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.52,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                    <GradientStop Color="#FFE6F0F9"/>
                                    <GradientStop Color="#FFF5EEFF" Offset="0.954"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Користувачі (Малі права)</TextBlock>
                        </Border>

                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.52,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                    <GradientStop Color="#FFE6F0F9"/>
                                    <GradientStop Color="#FFF5EEFF" Offset="0.954"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Користувачі (Великі права)</TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Width="296" Margin="16 50">
                        <StackPanel  Orientation="Horizontal" Margin="0 0 0 16">
                            <Image Source="Images/Syst.png" Width="80" Height="80" Margin="0 0 24 0"/>
                            <TextBlock VerticalAlignment="Center" FontSize="14px" FontWeight="Bold"  Foreground="#0ACDB6">СИСТЕМА</TextBlock>

                        </StackPanel>
                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFDEFEFE" />
                                    <GradientStop Color="#FFDCFBF7" Offset="0.949" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Звітність (Аналітика)</TextBlock>
                        </Border>

                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFDEFEFE" />
                                    <GradientStop Color="#FFDCFBF7" Offset="0.949" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Системні довідники</TextBlock>
                        </Border>

                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFDEFEFE" />
                                    <GradientStop Color="#FFDCFBF7" Offset="0.949" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Анкета компанії</TextBlock>
                        </Border>

                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFDEFEFE" />
                                    <GradientStop Color="#FFDCFBF7" Offset="0.949" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Права доступу</TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Width="296" Margin="16 50">
                        <StackPanel  Orientation="Horizontal" Margin="0 0 0 16">
                            <Image Source="Images/Diff.png" Width="80" Height="80" Margin="0 0 24 0"/>
                            <TextBlock VerticalAlignment="Center" FontSize="14px" FontWeight="Bold" Foreground="#FEA04A">ІНШЕ</TextBlock>

                        </StackPanel>
                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFFF4EC" />
                                    <GradientStop Color="#FFFFFAEA" Offset="0.949" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Представники компанії</TextBlock>
                        </Border>

                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFFF4EC" />
                                    <GradientStop Color="#FFFFFAEA" Offset="0.949" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Фіксація порушення авторських прав</TextBlock>
                        </Border>

                        <Border HorizontalAlignment="Stretch" Padding="24" CornerRadius="10" Margin="0 0 0 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFFF4EC" />
                                    <GradientStop Color="#FFFFFAEA" Offset="0.949" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap">Звіти онлайн-ресурсів</TextBlock>
                        </Border>
                    </StackPanel>
                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
