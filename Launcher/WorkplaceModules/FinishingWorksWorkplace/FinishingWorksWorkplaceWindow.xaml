<Window x:Class="Launcher.WorkplaceModules.FinishingWorksWorkplace.FinishingWorksWorkplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher.WorkplaceModules.FinishingWorksWorkplace"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:control="clr-namespace:IPSModulesLibrary.FinishingWorks;assembly=IPSModulesLibrary"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="Фінішні роботи" Height="450" Width="800">

    <Window.DataContext>
        <local:FinishingWorksWorkplaceViewModel/>
    </Window.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <control:FinishingWorksControl/>

</Window>
