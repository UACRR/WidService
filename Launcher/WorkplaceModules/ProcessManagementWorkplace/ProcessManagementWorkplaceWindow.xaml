<Window x:Class="Launcher.WorkplaceModules.ProcessManagementWorkplace.ProcessManagementWorkplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher.WorkplaceModules.ProcessManagementWorkplace"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:fw="clr-namespace:IPSModulesLibrary.FinishingWorks;assembly=IPSModulesLibrary"
        xmlns:ad="clr-namespace:IPSModulesLibrary.AccountantDocuments;assembly=IPSModulesLibrary"
        xmlns:pr="clr-namespace:IPSModulesLibrary.PaymentToRightholder;assembly=IPSModulesLibrary"
        xmlns:rc="clr-namespace:IPSModulesLibrary.RoyaltyCorrection;assembly=IPSModulesLibrary"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="Управління технологічними процесами" Height="450" Width="800">

    <Window.DataContext>
        <local:ProcessManagementWorkplaceViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IPSModulesLibrary;component/Resources/ResourceDictionaries/TabControlResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <TabControl SelectedItem="{Binding MainTabItem}">
        <TabItem Header="Головне" IsSelected="True">
            <fw:FinishingWorksControl/>
        </TabItem>

        <TabItem Header="Документи" Visibility="Collapsed">
            <ad:AccountantDocumentsControl/>
        </TabItem>

        <TabItem Header="Отримання коштів" IsEnabled="False">
            <pr:PaymentToRightholderControl/>
        </TabItem>

        <TabItem Header="Виправлення">
            <rc:RoyaltyCorrectionControl/>
        </TabItem>
    </TabControl>
</Window>
