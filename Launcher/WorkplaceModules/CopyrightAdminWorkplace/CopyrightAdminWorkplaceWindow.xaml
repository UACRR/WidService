<Window x:Class="Launcher.WorkplaceModules.CopyrightAdminWorkplace.CopyrightAdminWorkplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher.WorkplaceModules.CopyrightAdminWorkplace"
        xmlns:requestControl="clr-namespace:IPSViewComponentLibraryWPF.Modules.CopyrightRequest;assembly=IPSViewComponentLibraryWPF"
        xmlns:transferControl="clr-namespace:IPSViewComponentLibraryWPF.Modules.TransferOfRights;assembly=IPSViewComponentLibraryWPF"
        xmlns:pubsubList="clr-namespace:IpsViewComponentLibrary.PublisherAndSubpublisher;assembly=IpsViewComponentLibrary"
        xmlns:objectsRightList="clr-namespace:IPSModulesLibrary.ObjectsRightList;assembly=IPSModulesLibrary"
        xmlns:rightholdersList="clr-namespace:IPSModulesLibrary.RightholdersList;assembly=IPSModulesLibrary"
        xmlns:communitiesList="clr-namespace:IPSModulesLibrary.CommunitiesList;assembly=IPSModulesLibrary"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="{Binding LOC.TITLE_CRIGHT_ADMIN_WP}" Height="450" Width="800">

    <Window.DataContext>
        <local:CopyrightAdminWorkplaceViewModel/>
    </Window.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../ResourceDictionaries/TabControlResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <TabControl SelectedItem="{Binding MainTabItem}">
        <TabItem Header="{Binding LOC.RH_1}" IsSelected="True" Style="{StaticResource TabItemStyle}">
            <TabControl Margin="1 0 0 0" SelectedItem="{Binding RightholderNestedTabItem}">
                <TabItem Header="{Binding LOC.RH_2}" IsSelected="True" Style="{StaticResource TabItemStyle}">
                    <rightholdersList:RightholdersListControl/>
                </TabItem>
                <TabItem Header="{Binding LOC.RH_CHANGE}" Style="{StaticResource TabItemStyle}">
                    <transferControl:TransferOfRightsControl/>
                </TabItem>
                <TabItem Header="{Binding LOC.RH_REQUEST}" Style="{StaticResource TabItemStyle}">
                    <requestControl:CopyrightRequestControl/>
                </TabItem>
            </TabControl>
        </TabItem>
        <TabItem Header="{Binding LOC.OR}" Style="{StaticResource TabItemStyle}">
            <objectsRightList:ObjectsRightListControl/>
        </TabItem>
        <TabItem Header="{Binding LOC.COMMUNITIES}" Style="{StaticResource TabItemStyle}">
            <communitiesList:CommunitiesListControl/>
        </TabItem>
        <TabItem Header="{Binding LOC.PUB_SUB}" Style="{StaticResource TabItemStyle}">
            <WindowsFormsHost>
                <pubsubList:PublisherAndSubpublisherControl/>
            </WindowsFormsHost>
        </TabItem>
    </TabControl>
</Window>
