<Window x:Class="Launcher.WorkplaceModules.CopyrightAdminWorkplace.CopyrightAdminWorkplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher.WorkplaceModules.CopyrightAdminWorkplace"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:requestControl="clr-namespace:IPSViewComponentLibraryWPF.Modules.CopyrightRequest;assembly=IPSViewComponentLibraryWPF"
        xmlns:transferControl="clr-namespace:IPSViewComponentLibraryWPF.Modules.TransferOfRights;assembly=IPSViewComponentLibraryWPF"
        xmlns:communityList="clr-namespace:IpsViewComponentLibrary.CommunityControls;assembly=IpsViewComponentLibrary"
        xmlns:pubsubList="clr-namespace:IpsViewComponentLibrary.PublisherAndSubpublisher;assembly=IpsViewComponentLibrary"
        xmlns:objectsRightList="clr-namespace:IPSModulesLibrary.ObjectsRightList;assembly=IPSModulesLibrary"
        xmlns:rightholdersList="clr-namespace:IPSModulesLibrary.RightholdersList;assembly=IPSModulesLibrary"
        xmlns:communitiesList="clr-namespace:IPSModulesLibrary.CommunitiesList;assembly=IPSModulesLibrary"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="{Binding LOC.TITLE_CRIGHT_ADMIN_WP}" Height="450" Width="800">

    <Window.DataContext>
        <local:CopyrightAdminWorkplaceViewModel/>
    </Window.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>
        <Style TargetType="t:RadTabControl">
            <Setter Property="t:StyleManager.Theme" Value="Windows7"/>
        </Style>
    </Window.Resources>

    <Grid>
        <t:RadTabControl SelectedItem="{Binding MainTabItem}">
            <t:RadTabItem Header="{Binding LOC.RH_1}" IsSelected="True">
                <t:RadTabControl Margin="1 0 0 0" SelectedItem="{Binding RightholderNestedTabItem}">
                    <t:RadTabItem Header="{Binding LOC.RH_2}" IsSelected="True">
                        <rightholdersList:RightholdersListControl/>
                    </t:RadTabItem>
                    <t:RadTabItem Header="{Binding LOC.RH_CHANGE}">
                        <transferControl:TransferOfRightsControl/>
                    </t:RadTabItem>
                    <t:RadTabItem Header="{Binding LOC.RH_REQUEST}">
                        <requestControl:CopyrightRequestControl/>
                    </t:RadTabItem>
                </t:RadTabControl>
            </t:RadTabItem>
            <t:RadTabItem Header="{Binding LOC.OR}">
                <objectsRightList:ObjectsRightListControl/>
            </t:RadTabItem>
            <t:RadTabItem Header="{Binding LOC.COMMUNITIES}">
                <communitiesList:CommunitiesListControl/>
                <!--<WindowsFormsHost>
                    <communityList:CommunityControl/>
                </WindowsFormsHost>-->
            </t:RadTabItem>
            <t:RadTabItem Header="{Binding LOC.PUB_SUB}">
                <WindowsFormsHost>
                    <pubsubList:PublisherAndSubpublisherControl/>
                </WindowsFormsHost>
            </t:RadTabItem>
        </t:RadTabControl>
    </Grid>
</Window>
