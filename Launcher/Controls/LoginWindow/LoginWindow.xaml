<Window x:Class="Launcher.Controls.LoginWindow.LoginWindow"
        x:Name="thisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher.Controls.LoginWindow"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="../../Images/login-icon.png"
        Title="" Height="622.932" Width="400" SizeToContent="Height">

    <Window.DataContext>
        <local:LoginViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button" x:Key="submitButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#4A70FF" />
            <Setter Property="Foreground" Value="WhiteSmoke" />
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2, -55, 2, 2"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="145"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Blue"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="MyContentPresenter" 
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Background" Value="#1A4BFF"/>
                    <Setter Property="Foreground" Value="WhiteSmoke"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D6D8D8"/>
                    <Setter Property="Foreground" Value="Gray"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3862FF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#627DDF" />
                </Trigger>
            </Style.Triggers>

        </Style>

        <Style TargetType="TextBlock" x:Key="textBlock">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Gray"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox" x:Key="checkBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="AliceBlue"/>
            <Setter Property="Margin" Value="1,15,15,1"/>

            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Foreground" Value="DarkGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <t:RadBusyIndicator Height="Auto" IsBusy="{Binding IsBusy}" t:StyleManager.Theme="Crystal" BusyContent="Login...">
        <StackPanel Margin="0,0,0,0">
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0, 0" EndPoint="0, 1">
                    <GradientStop Color="DodgerBlue" Offset="0"/>
                    <GradientStop Color="Blue" Offset="0.35"/>
                    <GradientStop Color="MediumBlue" Offset="0.48"/>
                    <GradientStop Color="WhiteSmoke" Offset="0.90"/>
                </LinearGradientBrush>
            </StackPanel.Background>

            <Border >
                <TextBlock Text="SING IN"
                       FontSize="25"
                       Foreground="WhiteSmoke"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

            <StackPanel Orientation="Vertical">
                <Border
                            Margin="10"
                            Background="GhostWhite" 
                            BorderThickness="2" 
                            CornerRadius="10"
                            VerticalAlignment="Top"
                            BorderBrush="Silver">

                    <StackPanel Orientation="Vertical" Margin="10" >

                        <ComboBox Margin="1,1,1,10" 
                                Height="30" 
                                HorizontalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                SelectionChanged="AuthType_Selected">
                            <ComboBoxItem IsSelected="True">Use Windows Identification</ComboBoxItem>
                            <ComboBoxItem>Use Application Identification</ComboBoxItem>
                        </ComboBox>

                        <TextBlock
                                Style="{StaticResource textBlock}"
                                Text="Username" />
                        <TextBox x:Name="UserName"
                                Margin="1" 
                                Height="30" 
                                HorizontalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                IsEnabled="{Binding UserNameEnabled}"
                                Text="{Binding User.UserName}"/>

                        <TextBlock
                                Visibility="{Binding PasswordVisible}"
                                Style="{StaticResource textBlock}"
                                Padding="0,10,0,0" 
                                Text="Password" />
                        <PasswordBox
                                        Visibility="{Binding PasswordVisible}"
                                        x:Name="pwBox"
                                        Margin="1" 
                                        Height="30"
                                        HorizontalAlignment="Stretch"
                                        VerticalContentAlignment="Center" >
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="KeyUp">
                                    <i:InvokeCommandAction Command="{Binding KeyUpCommand}" PassEventArgsToCommand="True"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </PasswordBox>

                        <TextBlock
                                    Visibility="{Binding NewPasswordVisible}"
                                    Style="{StaticResource textBlock}"
                                    Padding="0,10,0,0" 
                                    Text="New Password" 
                                    IsEnabled="{Binding PasswordEnabled}"/>
                        <PasswordBox
                                    Visibility="{Binding NewPasswordVisible}"
                                    x:Name="newPwBox"
                                    Margin="1" 
                                    Height="30"
                                    HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    IsEnabled="{Binding PasswordEnabled}" />

                        <TextBlock
                                Visibility="{Binding NewPasswordVisible}"
                                Style="{StaticResource textBlock}"
                                Padding="0,10,0,0" 
                                Text="Confirm Password" 
                                IsEnabled="{Binding PasswordEnabled}"/>
                        <PasswordBox
                                    Visibility="{Binding NewPasswordVisible}"
                                    x:Name="confirmPwBox"
                                    Margin="1" 
                                    Height="30"
                                    HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    IsEnabled="{Binding PasswordEnabled}" />

                        <CheckBox
                                    Visibility="{Binding PasswordVisible}"
                                    IsEnabled="True"
                                    Style="{StaticResource checkBox}"
                                    Content="Change Password" 
                                    IsChecked="{Binding ChangePwd}"/>

                        <CheckBox
                                    IsEnabled="False"
                                    Visibility="{Binding PasswordVisible}"
                                    Style="{StaticResource checkBox}"
                                    Content="Remember" 
                                    IsChecked="{Binding Remember}"/>

                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10,10,10">
                    <Button 
                            Margin="5 5"
                            Content="LOGIN" 
                            Style="{StaticResource submitButton}"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=thisWindow}"/>
                    <Button 
                            Margin="5 5"
                            Content="CANCEL" 
                            Style="{StaticResource submitButton}"
                            Command="{Binding CancelCommand}"
                            CommandParameter="{Binding ElementName=thisWindow}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        </t:RadBusyIndicator>

</Window>
