<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher"
        xmlns:vm="clr-namespace:Launcher.General"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="Media Service" Height="440" Width="900" Icon="Images/main-icon.png">

    <Window.DataContext>
        <vm:LauncherViewModel/>
    </Window.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger x:Name="loadEvent" EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="25"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="textBlock" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="languageList" TargetType="{x:Type ComboBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" >
                                <ToggleButton.Template>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Border"  Grid.ColumnSpan="2" CornerRadius="5" Background="DeepSkyBlue" />
                                            <Border Grid.Column="0"  Margin="1"  Background="Transparent"   />
                                            <Path x:Name="Arrow" Grid.Column="1"  Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="ToggleButton.IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="Background" Value="#0e1666" />
                                            </Trigger>
                                            <Trigger Property="ToggleButton.IsChecked" Value="true">
                                                <Setter TargetName="Border" Property="Background" Value="#0e1666" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="3"  />
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"  Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1a229a"/>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="DodgerBlue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="languageList"
                      Grid.Column="1"
                      MinWidth="120"
                      Height="25"
                      Margin="3,3,30,3"
                      ToolTip="Обрати мову"
                      Padding="0,0" HorizontalAlignment="Left" 
                      Background="#1a237e" Cursor="Hand"
                      Style="{StaticResource languageList}"
                      ItemsSource="{Binding LanguagesItemSource}"
                      SelectedItem="{Binding CurrentLanguage}"
                      SelectedValuePath="SpecificationCode"
                      BorderBrush="Transparent">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding LanguageName}" 
                                   HorizontalAlignment="Stretch"
                                   Foreground="White"
                                   FontSize="18"
                                   Height="30"
                                   Padding="20,0"
                                   Cursor="Hand"
                                   VerticalAlignment="Center"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Grid.Column="2" Margin="0,0,35,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Background="GhostWhite"
                        Visibility="{Binding LoginButtonVisibility}"
                        Height="30"
                        Margin="5"
                        Command="{Binding LoginCommand}">
                    <Image Source="Images/login-icon.png"/>
                </Button>

                <Border Grid.Column="1"
                        Visibility="{Binding UserInfoVisibility}"
                        Width="auto"
                        BorderThickness="1" CornerRadius="5"
                        BorderBrush="Blue"
                        Background="Azure" 
                        Height="30">
                    <TextBlock Margin="10,0,10,0" 
                               VerticalAlignment="Center" 
                               Text="{Binding UserName, StringFormat='{}User Name: {0}'}"/>
                </Border>
            </Grid>

        </Grid>

        <ScrollViewer Grid.Row="1" IsEnabled="{Binding IsSignIn}">
            <WrapPanel>
                <t:RadButton>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <t:Label Grid.Row="0" 
                                 FontSize="15" 
                                 Content="(тест) Малі права" 
                                 HorizontalContentAlignment="Center"/>
                        <Separator Grid.Row="1" HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Row="2" 
                                   TextWrapping="Wrap" 
                                   FontSize="10"
                                   FontStyle="Italic" 
                                   Foreground="Gray" 
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Stretch"
                                   ToolTip="(тест) Інтерфейс роботи з клієнтами малих првав"
                                   Text="(тест) Інтерфейс роботи з клієнтами малих првав"/>

                    </Grid>
                </t:RadButton>

                <t:RadButton IsEnabled="True"
                             Command="{Binding LoadCopyrightAdminWorkplaceCommand}">
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip="{Binding LM_Launcher.RH_OR}"
                               Text="{Binding LM_Launcher.RH_OR}"/>
                </t:RadButton>

                <t:RadButton>
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip="{Binding LM_Launcher.ReportsAndRoyalty}"
                               Text="{Binding LM_Launcher.ReportsAndRoyalty}"/>
                </t:RadButton>

                <t:RadButton>
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip="{Binding LM_Launcher.AnalyticsAndReports}"
                               Text="{Binding LM_Launcher.AnalyticsAndReports}"/>
                </t:RadButton>

                <t:RadButton>
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip="{Binding LM_Launcher.OperativeReporting}"
                               Text="{Binding LM_Launcher.OperativeReporting}"/>
                </t:RadButton>

                <t:RadButton>
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip="{Binding LM_Launcher.Clients_WP}"
                               Text="{Binding LM_Launcher.Clients_WP}"/>
                </t:RadButton>
                
                <t:RadButton>
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip="{Binding LM_Launcher.Theatres_WP}"
                               Text="{Binding LM_Launcher.Theatres_WP}"/>
                </t:RadButton>
                
                <t:RadButton>
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip="{Binding LM_Launcher.Partner_WP}"
                               Text="{Binding LM_Launcher.Partner_WP}"/>
                </t:RadButton>
                
                <t:RadButton>
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip="{Binding LM_Launcher.FixationOfViolations}"
                               Text="{Binding LM_Launcher.FixationOfViolations}"/>
                </t:RadButton>
                
                <t:RadButton>
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip="{Binding LM_Launcher.SystemDictionaries}"
                               Text="{Binding LM_Launcher.SystemDictionaries}"/>
                </t:RadButton>

                <t:RadButton IsEnabled="False">
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip="{Binding LM_Launcher.AnketaOfTheCompany}"
                               Text="{Binding LM_Launcher.AnketaOfTheCompany}"/>
                </t:RadButton>

                <t:RadButton IsEnabled="{Binding LauncherPermits.UserAdmin}"
                             Command="{Binding LoadPermitWindowCommand}">
                    <TextBlock Style="{StaticResource textBlock}"
                               ToolTip=""
                               Text="Права доступу"/>
                </t:RadButton>

            </WrapPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="DodgerBlue">
            <t:Label HorizontalAlignment="Center" HorizontalContentAlignment="Center" Background="DeepSkyBlue" FontWeight="DemiBold" Content="IPS" Margin="3" Width="55"/>
        </Grid>

    </Grid>
</Window>
