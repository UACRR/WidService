                            Text="All"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="36"></TextBlock>
                            <TextBlock
                            Text="(2000)"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="28"></TextBlock>
                        </StackPanel>
                        <Border  Width="auto" Height="30" Margin="-15 -15"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Background="Red" 
                        CornerRadius="15" Padding="10" MinWidth="30">
                            <TextBlock
                            Text="1999"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White" 
                            FontWeight="Bold"
                        ></TextBlock>
                        </Border>
                    </Grid>
