<Window x:Class="LanguageService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LanguageService"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:viewModel="clr-namespace:LanguageService.ViewModel"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <viewModel:LanguageServiceViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="categoryStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f5f5f5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="languageMenu" Grid.Column="0">

            <Expander Header="Languages">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="English"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Russian"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Ukrainian"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander Header="Categories">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="All"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="General"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Category"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Category"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Category"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Category"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Category"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Category"/>
                    </Grid>
                </StackPanel>
            </Expander>
            
        </StackPanel>

        <Grid Grid.Column="1">
