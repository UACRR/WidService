<Window x:Class="LanguageService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LanguageService"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="Azure" Margin="3">

        </Grid>

        <Grid Grid.Column="1" Background="Beige" Margin="3">
            <t:RadGridView>
                <t:RadGridView.Columns>
                    <t:GridViewDataColumn Header="13245"/>
                    <t:GridViewDataColumn Header="qwerty"/>
                </t:RadGridView.Columns>
            </t:RadGridView>
        </Grid>

    </Grid>
</Window>
