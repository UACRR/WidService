<UserControl x:Class="IPSViewComponentLibraryWPF.Modules.Consumer.ConsumerSmallRight.Register.RegisterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Modules.Consumer.ConsumerSmallRight.Register"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:resx="clr-namespace:IPSViewComponentLibraryWPF.Properties"
             Background="WhiteSmoke"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.DataContext>
        <local:RegisterViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary Source="../../../../Properties/RDDefaultElementStyle.xaml"/>
    </UserControl.Resources>

    <Grid>
        <telerik:RadBusyIndicator>
            <!-- основний грід -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!--ліцензії та періоди-->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>

                    <!--ліцензії-->
                    <Grid Grid.Row="0" Margin="0,0,2,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <telerik:RadToggleButton Grid.Column="0"
                                                     Height="18"
                                                     telerik:StyleManager.Theme="VisualStudio2013"
                                                     Margin="1"
                                                     IsEnabled="False"
                                                     IsChecked="False">
                                <Image Source="../../../../Resources/Icons/filter-icon.png"/>
                            </telerik:RadToggleButton>


                            <telerik:Label Grid.Column="1" 
                                           Content="Ліцензійні договори"
                                           FontSize="13"
                                           Background="AliceBlue"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <!--настройки-->
                            </Grid>

                            <telerik:RadGridView Grid.Column="1" 
                                             ShowToolTipOnTrimmedText="True" 
                                             IsReadOnly="True" 
                                             ShowSearchPanel="True"
                                             ColumnWidth="*"
                                             ItemsSource="{Binding}"
                                             SelectedItem="{Binding}">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="Тип ліцензії" DataMemberBinding="{Binding}"/>
                                    <telerik:GridViewDataColumn Header="Серія" DataMemberBinding="{Binding}"/>
                                    <telerik:GridViewDataColumn Header="Номер договору" DataMemberBinding="{Binding}"/>
                                    <telerik:GridViewDataColumn Header="Сума вимоги" DataMemberBinding="{Binding}"/>
                                    <telerik:GridViewDataColumn Header="Періодичність оплати" DataMemberBinding="{Binding}"/>
                                    <telerik:GridViewDataColumn Header="Наявний борг" DataMemberBinding="{Binding}"/>

                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </Grid>
                    </Grid>
                    <!--<telerik:RadToolBarSeparator Grid.Row="1" Grid.Column="0" Margin="10,0,10,0" VerticalAlignment="Center" Background="LightSlateGray" Height="1" telerik:StyleManager.Theme="VisualStudio2013"/>-->

                    <!--періоди-->
                    <Grid Grid.Row="1" Margin="2,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <telerik:RadToggleButton Grid.Column="0"
                                                         Height="18"
                                                         telerik:StyleManager.Theme="VisualStudio2013"
                                                         Margin="1"
                                                         IsEnabled="False"
                                                         IsChecked="False">
                                    <Image Source="../../../../Resources/Icons/filter-icon.png"/>
                                </telerik:RadToggleButton>

                                <telerik:Label Grid.Column="1" 
                                               Content="Періоди платежів по ліцензії"
                                               FontSize="13"
                                               Background="AliceBlue"/>
                            </Grid>

                            <telerik:RadGridView Grid.Row="1" 
                                                 IsReadOnly="True"
                                                 ColumnWidth="*">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="Період" DataMemberBinding="{Binding}"/>
                                    <telerik:GridViewDataColumn Header="Стан періоду" DataMemberBinding="{Binding}"/>
                                    <telerik:GridViewDataColumn Header="Вимога по періоду" DataMemberBinding="{Binding}"/>
                                    <telerik:GridViewDataColumn Header="Розподілено" DataMemberBinding="{Binding}"/>
                                    <telerik:GridViewDataColumn Header="К-сть звітів" DataMemberBinding="{Binding}"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>

                            <telerik:RadButton Grid.Row="2"
                                               Margin="3"
                                               HorizontalAlignment="Left" 
                                               Height="22"
                                               Command="{Binding}"
                                               Content="Додати період"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Р/Л та звіти періода -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                     <!--розрахунковий лист-->
                     <Grid Grid.Column="0" Margin="0,0,2,0" Visibility="{Binding RegisterRatedListPanelVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <telerik:Label Grid.Row="0"
                                           Content="Розрахунковийй лист"
                                           FontSize="13"
                                           Background="AliceBlue"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!--заголовки-->
                            <telerik:Label Margin="1" Grid.Row="0" Grid.Column="0" Content="Номер Р/Л"/>
                            <telerik:Label Grid.Row="1" Grid.Column="0" Content="Сума валового збору"/>
                            <telerik:Label Grid.Row="2" Grid.Column="0" Content="Сума авторської винагороди"/>
                            <telerik:Label Grid.Row="3" Grid.Column="0" Content="К-сть звітів"/>
                            <telerik:Label Grid.Row="4" Grid.Column="0" Content="Сформовано звітів"/>
                            <!--дані-->
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="1" Background="Transparent" IsReadOnly="True" IsReadOnlyCaretVisible="False" VerticalContentAlignment="Center" Text="226"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="1" Text="105 000 555.0045"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="1" Text="154555.55"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="1" Text="20"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="1" Text="13"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <StackPanel Orientation="Horizontal" Margin="3">
                                <telerik:RadButton Content="Створити" Margin="0,0,5,0"/>
                                <telerik:RadButton Content="Редагувати"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!--звіти-->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--звіти періода-->
                        <Grid Grid.Row="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <telerik:Label Grid.Row="0" 
                                                   Content="Звіти обраного періода" 
                                                   FontSize="13"
                                                   Background="AliceBlue"/>
                                <telerik:RadGridView Grid.Row="1"
                                                     ColumnWidth="*">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="ID" DataMemberBinding="{Binding}"/>
                                        <telerik:GridViewDataColumn Header="Назва звіту" DataMemberBinding="{Binding}"/>
                                        <telerik:GridViewDataColumn Header="№ Р/Л" DataMemberBinding="{Binding}"/>
                                        <telerik:GridViewDataColumn Header="%" DataMemberBinding="{Binding}"/>
                                        <telerik:GridViewDataColumn Header="Сума" DataMemberBinding="{Binding}"/>
                                        <telerik:GridViewDataColumn Header="Стан" DataMemberBinding="{Binding}"/>
                                        <!--змінити курс валют-->
                                        <telerik:GridViewColumn Width="25" IsVisible="False">
                                            <telerik:GridViewColumn.Header>
                                                <Image Width="15" Source="../../../../Resources/Icons/currency-exchange-icon.ico"/>
                                            </telerik:GridViewColumn.Header>
                                            <telerik:GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <telerik:RadButton Margin="0" Command="{Binding}">
                                                        <telerik:RadButton.ToolTip>
                                                            <ToolTip Content="Змінити курс валют"/>
                                                        </telerik:RadButton.ToolTip>
                                                        <Image Width="15" Source="../../../../Resources/Icons/currency-exchange-icon.ico"/>
                                                    </telerik:RadButton>
                                                </DataTemplate>
                                            </telerik:GridViewColumn.CellTemplate>
                                        </telerik:GridViewColumn>
                                        <!--редагувати переглянути звичайний звіт-->
                                        <telerik:GridViewColumn Width="25" IsVisible="True">
                                            <telerik:GridViewColumn.Header>
                                                <Image Width="15" Source="../../../../Resources/Icons/edit-icon.ico"/>
                                            </telerik:GridViewColumn.Header>
                                            <telerik:GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <telerik:RadButton Margin="0" Command="{Binding}">
                                                        <Image Width="15" Source="../../../../Resources/Icons/edit-icon.ico"/>
                                                    </telerik:RadButton>
                                                </DataTemplate>
                                            </telerik:GridViewColumn.CellTemplate>
                                        </telerik:GridViewColumn>
                                        <!--видалити звіт-->
                                        <telerik:GridViewColumn Width="25" IsVisible="True">
                                            <telerik:GridViewColumn.Header>
                                                <Image Width="15" Source="../../../../Resources/Icons/delete-icon.ico"/>
                                            </telerik:GridViewColumn.Header>
                                            <telerik:GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <telerik:RadButton Margin="0" Command="{Binding}">
                                                        <Image Width="15" Source="../../../../Resources/Icons/delete-icon.ico"/>
                                                    </telerik:RadButton>
                                                </DataTemplate>
                                            </telerik:GridViewColumn.CellTemplate>
                                        </telerik:GridViewColumn>
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </Grid>
                        </Grid>
                        <!--панель кнопок-->
                        <Grid Grid.Row="1">
                            <Grid Margin="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!--додати звіт-->
                                <telerik:RadDropDownButton Grid.Column="0" 
                                                           HorizontalAlignment="Left"
                                                           Content="Додати звіт"
                                                           telerik:StyleManager.Theme="VisualStudio2013" 
                                                           Margin="3"
                                                           Width="120">
                                    <telerik:RadDropDownButton.DropDownContent>
                                        <StackPanel>
                                            <telerik:RadButton Margin="0" HorizontalContentAlignment="Left" Content="Додати звіт з файлу"/>
                                            <telerik:RadButton Margin="0,5,0,0" Content="Додати звіт через ручне введення"/>
                                        </StackPanel>
                                    </telerik:RadDropDownButton.DropDownContent>
                                </telerik:RadDropDownButton>

                                <!--дії зі звітами-->
                                <telerik:RadDropDownButton Grid.Column="1" 
                                                           HorizontalAlignment="Right" 
                                                           Content="Дії" 
                                                           Margin="3"
                                                           Width="120">
                                    <telerik:RadDropDownButton.DropDownContent>
                                        <StackPanel>
                                            <telerik:RadButton Content="Відправити на погодження"/>
                                            <telerik:RadButton Content="Зафіксувати перелік звітів"/>
                                        </StackPanel>
                                    </telerik:RadDropDownButton.DropDownContent>
                                </telerik:RadDropDownButton>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </telerik:RadBusyIndicator>
    </Grid>
</UserControl>
