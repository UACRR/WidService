<UserControl x:Class="IPSViewComponentLibraryWPF.Modules.Consumer.ConsumerSmallRight.Register.RegisterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Modules.Consumer.ConsumerSmallRight.Register"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             Background="WhiteSmoke"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style TargetType="telerik:RadGridView">
            <Setter Property="telerik:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="RowIndicatorVisibility" Value="Collapsed"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="AllowDrop" Value="False"/>
            <Setter Property="ShowGroupPanel" Value="False"/>
            <Setter Property="IsFilteringAllowed" Value="False"/>
        </Style>
        <Style TargetType="telerik:GridViewHeaderCell">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="telerik:Label">
            <Setter Property="telerik:StyleManager.Theme" Value="VisualStudio2013"/>

        </Style>

        <Style TargetType="telerik:RadButton">
            <Setter Property="telerik:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>

        <Style TargetType="telerik:RadDropDownButton">
            <Setter Property="telerik:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <!--<ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RegisterStyleResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>-->
    </UserControl.Resources>

    <UserControl.DataContext>
        <local:RegisterViewModel/>
    </UserControl.DataContext>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadDataCommand}" x:Name="controlLoaded"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <telerik:RadBusyIndicator 
            IsBusy="{Binding IsBusy, IsAsync=True}"
            Name="busyIndicator"
            IsIndeterminate="True"
            telerik:StyleManager.Theme="VisualStudio2013">
            <!-- основний грід -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!--ліцензії та періоди-->
                <Grid Grid.Row="0" IsEnabled="{Binding IsEnabledGrid}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>

                    <!--ліцензії-->
                    <Grid Grid.Row="0" Margin="0,0,2,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <telerik:RadToggleButton Grid.Column="0"
                                                     Height="18"
                                                     telerik:StyleManager.Theme="VisualStudio2013"
                                                     Margin="1"
                                                     IsEnabled="False"
                                                     IsChecked="False">
                                <Image Source="../../../../Resources/Icons/filter-icon.png"/>
                            </telerik:RadToggleButton>


                            <telerik:Label Grid.Column="1" 
                                           Content="Ліцензійні договори"
                                           FontSize="13"
                                           FontWeight="DemiBold"
                                           Background="LightBlue"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <!--настройки-->
                            </Grid>

                            <telerik:RadGridView Grid.Column="1" 
                                                 ShowToolTipOnTrimmedText="True" 
                                                 IsReadOnly="True" 
                                                 ShowSearchPanel="True"
                                                 ColumnWidth="*"
                                                 IsSynchronizedWithCurrentItem="True"
                                                 ItemsSource="{Binding LicenseAgreementsItemSource}"
                                                 SelectedItem="{Binding CurrentLicenseAgreement}">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="ID" DataMemberBinding="{Binding LicId}" Width="75" />
                                    <telerik:GridViewDataColumn Header="Тип ліцензії" DataMemberBinding="{Binding LicenseTypeName}"/>
                                    <telerik:GridViewDataColumn Header="Серія" DataMemberBinding="{Binding LicenseSeries}" Width="50" />
                                    <telerik:GridViewDataColumn Header="Номер договору" DataMemberBinding="{Binding AgrNumber}"/>
                                    <telerik:GridViewDataColumn Header="Дата початку" DataMemberBinding="{Binding DateBegin, StringFormat='{}{0:d}'}" Width="90" />
                                    <telerik:GridViewDataColumn Header="Дата завершення" DataMemberBinding="{Binding DateEnd, StringFormat='{}{0:d}'}" Width="90" />
                                    <telerik:GridViewDataColumn Header="Періодичність оплати" DataMemberBinding="{Binding PeriodPaymentName}"/>
                                    <telerik:GridViewDataColumn Header="Сума вимоги" DataMemberBinding="{Binding MinAmount, StringFormat='{}{0:N2}'}"/>
                                    <telerik:GridViewDataColumn Header="Наявний борг" DataMemberBinding="{Binding Debt, StringFormat='{}{0:N2}'}"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </Grid>
                    </Grid>

                    <!--періоди-->
                    <Grid Grid.Row="1" Margin="2,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <telerik:RadToggleButton Grid.Column="0"
                                                         Height="18"
                                                         telerik:StyleManager.Theme="VisualStudio2013"
                                                         Margin="1"
                                                         IsEnabled="False"
                                                         IsChecked="False">
                                <Image Source="../../../../Resources/Icons/filter-icon.png"/>
                            </telerik:RadToggleButton>

                            <telerik:Label Grid.Column="1" 
                                               Content="Періоди платежів по ліцензії"
                                               FontSize="13"
                                               FontWeight="DemiBold"
                                               Background="LightBlue"/>
                        </Grid>

                        <telerik:RadGridView Grid.Row="1" 
                                             IsReadOnly="True"
                                             ColumnWidth="*"
                                             x:Name="licenseGrid"
                                             IsSynchronizedWithCurrentItem="True"
                                             ItemsSource="{Binding PeriodsOfLicenseItemSource}"
                                             SelectedItem="{Binding CurrentPeriodOfLicense}">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="ID" DataMemberBinding="{Binding PeriodId}" Width="75" />
                                <telerik:GridViewDataColumn Header="Назва періоду" DataMemberBinding="{Binding PeriodName}"/>
                                <telerik:GridViewDataColumn Header="Дата початку періоду" DataMemberBinding="{Binding BeginDate, StringFormat='{}{0:d}'}"/>
                                <telerik:GridViewDataColumn Header="Дата завершення періоду" DataMemberBinding="{Binding EndDate, StringFormat='{}{0:d}'}"/>
                                <telerik:GridViewDataColumn Header="Стан періоду" DataMemberBinding="{Binding PeriodStatusName}"/>
                                <telerik:GridViewDataColumn Header="Вимога по періоду" DataMemberBinding="{Binding Amount, StringFormat='{}{0:N2}'}"/>
                                <telerik:GridViewDataColumn Header="Розподілено" DataMemberBinding="{Binding Distribamount, StringFormat='{}{0:N2}'}"/>
                                <telerik:GridViewDataColumn Header="К-сть звітів" 
                                                                DataMemberBinding="{Binding CountReportsOfPeriod}" 
                                                                HeaderTextAlignment="Center" 
                                                                TextAlignment="Center"
                                                                Width="80"/>
                            </telerik:RadGridView.Columns>

                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Sorted">
                                    <b:InvokeCommandAction Command="{Binding SortedPeriodsOfLicenseCommand}" PassEventArgsToCommand="True"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </telerik:RadGridView>

                        <telerik:RadButton Grid.Row="2"
                                           Margin="3"
                                           HorizontalAlignment="Left" 
                                           Height="22"
                                           Command="{Binding CreatePeriodCommand}"
                                           Content="Додати період"/>
                    </Grid>
                </Grid>

                <!-- Р/Л та звіти періода -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                     <!--розрахунковий лист-->
                     <Grid Grid.Column="0" Margin="0,0,2,0" Visibility="{Binding RegisterRatedListPanelVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                         <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="7"/>
                        </Grid.ColumnDefinitions>

                         <telerik:RadToggleButton Grid.Row="0" Grid.Column="0"
                                                  Background="AliceBlue"
                                                  telerik:StyleManager.Theme="VisualStudio2013"
                                                  Margin="2"
                                                  FontSize="13"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{Binding RegisterRatedListInfoButtonChecked}"
                                                  Content="{Binding RegisterRatedListInfoButtonContent}"/>


                        <Grid Grid.Row="1" Grid.Column="0" Visibility="{Binding RegisterRatedListInfoMinimize}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition MinWidth="80"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!--заголовки-->
                            <telerik:Label Margin="1" Grid.Row="0" Grid.Column="0" Content="Номер Р/Л"/>
                            <telerik:Label Margin="1" Grid.Row="1" Grid.Column="0" Content="Статус"/>
                            <telerik:Label Margin="1" Grid.Row="2" Grid.Column="0" Content="Сума валового збору"/>
                            <telerik:Label Margin="1" Grid.Row="3" Grid.Column="0" Content="Сума авторської винагороди"/>
                            <telerik:Label Margin="1" Grid.Row="4" Grid.Column="0" Content="К-сть звітів"/>
                            <telerik:Label Margin="1" Grid.Row="5" Grid.Column="0" Content="Сформовано звітів"/>
                            <!--дані-->
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RegisterRatedList.RmId}" 
                                     IsReadOnly="True" 
                                     Background="Transparent" 
                                     IsReadOnlyCaretVisible="False" 
                                     VerticalContentAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RegisterRatedList.StatusName}" 
                                     IsReadOnly="True" 
                                     Background="Transparent" 
                                     IsReadOnlyCaretVisible="False" 
                                     VerticalContentAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RegisterRatedList.Amount, StringFormat='{}{0:N2}'}" 
                                     IsReadOnly="{Binding RegisterRatedListReadOnly}" 
                                     IsReadOnlyCaretVisible="False"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RegisterRatedList.Royalty, StringFormat='{}{0:N2}'}" 
                                     IsReadOnly="{Binding RegisterRatedListReadOnly}" 
                                     IsReadOnlyCaretVisible="False"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RegisterRatedList.CountReport}" 
                                     IsReadOnly="{Binding RegisterRatedListReadOnly}" 
                                     IsReadOnlyCaretVisible="False"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RegistersItemSource.Count, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     Background="Transparent" 
                                     IsReadOnlyCaretVisible="False"/>
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="0" Visibility="{Binding RegisterRatedListInfoMinimize}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <telerik:RadButton Grid.Column="0" Margin="3" Content="Створити Р/Л" 
                                               Visibility="{Binding RrlCreateButtonVisibility}"
                                               Command="{Binding CreateRegisterRatedListCommand}"/>
                            <telerik:RadButton Grid.Column="1" Margin="3" Content="Редагувати Р/Л" 
                                               Visibility="{Binding RrlEditButtonVisibility}"
                                               Command="{Binding EditRegisterRatedListCommand}"/>
                            <telerik:RadButton Grid.Column="2" Margin="3" Content="Зберегти" 
                                               Visibility="{Binding RrlSaveButtonVisibility}"
                                               Command="{Binding SaveRegisterRatedListCommand}"/>
                            <telerik:RadButton Grid.Column="3" Margin="3" Content="Скасувати" 
                                               Visibility="{Binding RrlCancelButtonVisibility}"
                                               Command="{Binding CancelChangesRegisterRatedListCommand}"/>

                        </Grid>
                    </Grid>

                    <!--звіти-->
                    <Grid Grid.Column="1" IsEnabled="{Binding IsEnabledGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--звіти періода-->
                        <Grid Grid.Row="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <telerik:Label Grid.Row="0" 
                                                   Content="Звіти обраного періода" 
                                                   FontSize="13"
                                                   FontWeight="DemiBold"
                                                   Background="LightBlue"/>
                                <telerik:RadGridView Grid.Row="1"
                                                     ColumnWidth="*"
                                                     IsReadOnly="True"
                                                     SelectionMode="Single"
                                                     ItemsSource="{Binding RegistersItemSource}"
                                                     SelectedItem="{Binding CurrentRegister}">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="ID" DataMemberBinding="{Binding RegId}" Width="75"/>
                                        <telerik:GridViewDataColumn Header="Назва звіту" DataMemberBinding="{Binding FileName}"/>
                                        <telerik:GridViewDataColumn Header="Сума валового збору" 
                                                                    DataMemberBinding="{Binding RegAmount, StringFormat='{}{0:N2}'}"
                                                                    IsVisible="{Binding IsRegisterRatedList}"/>
                                        <telerik:GridViewDataColumn Header="% А/В від валового збору" 
                                                                    DataMemberBinding="{Binding RegRate, StringFormat='{}{0:N2}'}"
                                                                    IsVisible="{Binding IsRegisterRatedList}"/>
                                        <telerik:GridViewDataColumn Header="Сума авторської винагороди" 
                                                                    DataMemberBinding="{Binding RegRoyalty, StringFormat='{}{0:N2}'}"
                                                                    IsVisible="{Binding IsRegisterRatedList}"/>
                                        <telerik:GridViewDataColumn Header="Сума звіту" 
                                                                    DataMemberBinding="{Binding RegRoyalty, StringFormat='{}{0:N2}'}"
                                                                    IsVisible="{Binding RegisterAmountVisible}"/>
                                        <telerik:GridViewDataColumn Header="Стан звіту" DataMemberBinding="{Binding RgStatusName}"/>
                                        <telerik:GridViewDataColumn Header="К-сть записів у звіті" DataMemberBinding="{Binding CountRows}"/>
                                        <!-- курс валют-->
                                        <telerik:GridViewColumn Width="25" IsVisible="{Binding CurrencyExchangeVisible}">
                                            <telerik:GridViewColumn.Header>
                                                <Image Width="20" Source="../../../../Resources/Icons/currency-exchange-icon.png"/>
                                            </telerik:GridViewColumn.Header>
                                            <telerik:GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <telerik:RadButton Margin="0" 
                                                                       Command="{Binding DataContext.ChangeCurrencyExchangeCommand, RelativeSource={RelativeSource AncestorType={x:Type telerik:RadGridView}}}"
                                                                       CommandParameter="{Binding}">
                                                        <telerik:RadButton.ToolTip>
                                                            <ToolTip Content="Курс валют"/>
                                                        </telerik:RadButton.ToolTip>
                                                        <Image Width="20" Source="../../../../Resources/Icons/currency-exchange-icon.png"/>
                                                    </telerik:RadButton>
                                                </DataTemplate>
                                            </telerik:GridViewColumn.CellTemplate>
                                        </telerik:GridViewColumn>
                                        <!--редагувати/переглянути звичайний звіт-->
                                        <telerik:GridViewColumn Width="25">
                                            <telerik:GridViewColumn.Header>
                                                <Image Width="19" Source="../../../../Resources/Icons/edit-icon.png"/>
                                            </telerik:GridViewColumn.Header>
                                            <telerik:GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <telerik:RadButton Margin="0" 
                                                                       Command="{Binding DataContext.OpenRegisterCommand, RelativeSource={RelativeSource AncestorType={x:Type telerik:RadGridView}}}"
                                                                       CommandParameter="{Binding}">
                                                        <Image Width="19" Source="../../../../Resources/Icons/edit-icon.png"/>
                                                    </telerik:RadButton>
                                                </DataTemplate>
                                            </telerik:GridViewColumn.CellTemplate>
                                        </telerik:GridViewColumn>
                                        <!--видалити звіт-->
                                        <telerik:GridViewColumn Width="25" IsVisible="{Binding RemoveRegisterVisible}">
                                            <telerik:GridViewColumn.Header>
                                                <Image Width="17" Source="../../../../Resources/Icons/delete-icon.png"/>
                                            </telerik:GridViewColumn.Header>
                                            <telerik:GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <telerik:RadButton Margin="0" 
                                                                       Command="{Binding DataContext.RemoveRegisterCommand, RelativeSource={RelativeSource AncestorType={x:Type telerik:RadGridView}}}"
                                                                       CommandParameter="{Binding}">
                                                        <Image Width="17" Source="../../../../Resources/Icons/delete-icon.png"/>
                                                    </telerik:RadButton>
                                                </DataTemplate>
                                            </telerik:GridViewColumn.CellTemplate>
                                        </telerik:GridViewColumn>
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </Grid>
                        </Grid>
                        <!--панель кнопок-->
                        <StackPanel Grid.Row="1" 
                                    Margin="1" 
                                    Orientation="Horizontal">
                            <!--додати звіт-->
                            <telerik:RadDropDownButton HorizontalAlignment="Left"
                                                       Content="Додати звіт"
                                                       telerik:StyleManager.Theme="VisualStudio2013"
                                                       CloseOnPopupMouseLeftButtonUp="True"
                                                       Visibility="{Binding CreateReportButtonsVisibility}"
                                                       Margin="3"
                                                       Width="120">
                                <telerik:RadDropDownButton.DropDownContent>
                                    <StackPanel>
                                        <telerik:RadButton Margin="0" HorizontalContentAlignment="Left" 
                                                           Content="Додати звіт з файлу"
                                                           Command="{Binding CreateRegisterFromFileCommand}"/>
                                        <telerik:RadButton Margin="0,1,0,0" 
                                                           Content="Додати звіт через ручне введення"
                                                           Command="{Binding CreateRegisterManuallyCommand}"/>
                                    </StackPanel>
                                </telerik:RadDropDownButton.DropDownContent>
                            </telerik:RadDropDownButton>

                            <!--дії зі звітами-->
                            <telerik:RadDropDownButton HorizontalAlignment="Left"
                                                       Content="Дії" 
                                                       telerik:StyleManager.Theme="VisualStudio2013"
                                                       CloseOnPopupMouseLeftButtonUp="True"
                                                       Margin="3"
                                                       Width="120">
                                <telerik:RadDropDownButton.DropDownContent>
                                    <StackPanel>
                                        <telerik:RadButton Margin="0" 
                                                           Content="Відправити на погодження"
                                                           Command="{Binding SendRegisterToAcceptCommand}"/>
                                        <telerik:RadButton Margin="0,1,0,0"
                                                           Content="Зафіксувати перелік звітів"
                                                           Command="{Binding FixingRegisterListCommand}"/>
                                    </StackPanel>
                                </telerik:RadDropDownButton.DropDownContent>
                            </telerik:RadDropDownButton>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </telerik:RadBusyIndicator>
    </Grid>
</UserControl>
