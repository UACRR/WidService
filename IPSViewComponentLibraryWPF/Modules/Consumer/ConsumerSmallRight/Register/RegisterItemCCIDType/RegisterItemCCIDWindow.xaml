<Window x:Class="IPSViewComponentLibraryWPF.Modules.Consumer.ConsumerSmallRight.Register.RegisterItemCCIDType.RegisterItemCCIDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Modules.Consumer.ConsumerSmallRight.Register.RegisterItemCCIDType"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        WindowState="Maximized"
        mc:Ignorable="d"
        d:DesignHeight="500"
        d:DesignWidth="800"
        Title="{Binding Title}" 
        Height="450" 
        Width="800">

    <Window.DataContext>
        <local:RegisterItemCCIDViewModel/>
    </Window.DataContext>
    
    <Window.Resources>
        <Style TargetType="t:RadGridView">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="AllowDrop" Value="False"/>
            <Setter Property="ShowGroupPanel" Value="False"/>
            <Setter Property="ShowSearchPanel" Value="True"/>
            <Setter Property="ShowToolTipOnTrimmedText" Value="True"/>
            <Setter Property="IsFilteringAllowed" Value="False"/>
        </Style>
        <Style TargetType="t:GridViewHeaderCell">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>
    <Grid>
        <t:RadGridView ItemsSource="{Binding RegisterItemsItemSource}">
            <t:RadGridView.Columns>
                <t:GridViewDataColumn Header="Назва використаного твору" DataMemberBinding="{Binding ItemName}"/>
                <t:GridViewDataColumn Header="Виконавець - П.І.Б. виконавця (співвиконавців) або назва колективу виконавців" DataMemberBinding="{Binding Performer}"/>
                <t:GridViewDataColumn Header="Автор музики (П.І.Б.)" DataMemberBinding="{Binding AuthorMusic}"/>
                <t:GridViewDataColumn Header="Автор тексту (П.І.Б.)" DataMemberBinding="{Binding AuthorText}"/>

                <t:GridViewDataColumn Header="Сума за публічне використання (в валюті звіту)" DataMemberBinding="{Binding AmountMechCurrency, StringFormat='{}{0:N2}'}"/>
                <t:GridViewDataColumn Header="Сума за публічне використання (в грн)" DataMemberBinding="{Binding AmountMech, StringFormat='{}{0:N2}'}"/>
                <t:GridViewDataColumn Header="Сума за механічне використання (в валюті звіту)" DataMemberBinding="{Binding AmountMechCurrency, StringFormat='{}{0:N2}'}"/>
                <t:GridViewDataColumn Header="Сума за механічне використання (в грн)" DataMemberBinding="{Binding AmountMech, StringFormat='{}{0:N2}'}"/>
            </t:RadGridView.Columns>
        </t:RadGridView>
    </Grid>
</Window>
