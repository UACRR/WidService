<Window x:Class="IPSViewComponentLibraryWPF.Modules.Consumer.ConsumerSmallRight.Register.CreatePaidPeriod.CreatePaidPeriod"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Modules.Consumer.ConsumerSmallRight.Register.CreatePaidPeriod"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        SizeToContent="Height"
        MinHeight="200"
        Title="Створити період" Width="425"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:CreatePaidPeriodViewModel/>
    </Window.DataContext>
    

    <Window.Resources>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style TargetType="t:Label">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1"/>
        </Style>
        <Style TargetType="t:RadDatePicker">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="1"/>
        </Style>
    </Window.Resources>
    <t:RadBusyIndicator
        IsBusy="{Binding IsBusy, IsAsync=True}"
        Name="busyIndicator"
        IsIndeterminate="True"
        t:StyleManager.Theme="VisualStudio2013">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5 10">
                    <RadioButton x:Name="rbCalendar" IsChecked="{Binding PeriodMode.IsDefault, Mode=TwoWay}" Content="Календарний період"></RadioButton>
                    <RadioButton x:Name="rbCustom" Margin="10 0 0 0" IsChecked="{Binding PeriodMode.IsCustom, Mode=TwoWay}" Content="Користувацький період"></RadioButton>
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="5 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PeriodMode.IsDefault}" Value="true">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <t:Label Grid.Row="0" Grid.Column="0" Content="Початкова дата" ToolTip="Дата з якої починається період"/>
                    <t:RadDatePicker Grid.Row="0" Grid.Column="1" Margin="1" SelectedValue="{Binding BeginDate, Mode=TwoWay}"/>
                    <t:Label Grid.Row="2" Grid.Column="0" Content="Назва періоду"/>
                    <t:RadComboBox ItemsSource="{Binding SelectablePeriods}"
                                   SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                                   DisplayMemberPath="PeriodName"
                                   SelectedValuePath="Value"
                                   t:StyleManager.Theme="VisualStudio2013"
                                   Margin="1" Grid.Row="2" Grid.Column="1"/>
                </Grid>

                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PeriodMode.IsCustom}" Value="true">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <t:Label Grid.Row="0" Grid.Column="0" Content="Назва періоду"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Period.PeriodName, Mode=TwoWay}"/>



                    <t:Label Grid.Row="1" Grid.Column="0" Content="Дата початку"/>
                    <t:RadDatePicker Grid.Row="1" Grid.Column="1"
                                     SelectedValue="{Binding Period.BeginDate, Mode=TwoWay}" Culture="uk-UA"/>

                    <t:Label Grid.Row="2" Grid.Column="0" Content="Дата завершення"/>
                    <t:RadDatePicker Grid.Row="2" Grid.Column="1"
                                     SelectedValue="{Binding Period.EndDate, Mode=TwoWay}" Culture="uk-UA"/>

                </Grid>

            </Grid>

            <StackPanel Grid.Row="1" FlowDirection="RightToLeft" Orientation="Horizontal" Background="Silver">
                <t:RadButton Content="Скасувати"
                             IsCancel="True"
                             Command="{Binding CloseWindowCommand}"
                             CommandParameter="{Binding ElementName=thisWindow}"/>
                <t:RadButton Content="Зберегти"
                             Command="{Binding SaveCommand}"
                             CommandParameter="{Binding ElementName=thisWindow}"/>
            </StackPanel>
        </Grid>
    </t:RadBusyIndicator>
</Window>
