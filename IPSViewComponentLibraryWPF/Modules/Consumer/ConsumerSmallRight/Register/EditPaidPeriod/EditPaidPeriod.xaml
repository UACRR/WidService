<Window x:Class="IPSViewComponentLibraryWPF.Modules.Consumer.ConsumerSmallRight.Register.EditPaidPeriod.EditPaidPeriod"
        x:Name="thisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Modules.Consumer.ConsumerSmallRight.Register.EditPaidPeriod"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        ResizeMode="NoResize"
        Title="Редагування періоду" Height="200" Width="425"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <Window.DataContext>
        <local:EditPaidPeriodViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style TargetType="t:Label">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1"/>
        </Style>
        <Style TargetType="t:RadDatePicker">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="1"/>
        </Style>
    </Window.Resources>

    <t:RadBusyIndicator
        IsBusy="{Binding IsBusy, IsAsync=True}"
        Name="busyIndicator"
        IsIndeterminate="True"
        t:StyleManager.Theme="VisualStudio2013">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <t:Label Grid.Row="0" Grid.Column="0" Content="Назва періоду"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Period.PeriodName, Mode=TwoWay}"/>

                <t:Label Grid.Row="1" Grid.Column="0" Content="Дата початку"/>
                <t:RadDatePicker Grid.Row="1" Grid.Column="1"
                                 SelectedValue="{Binding Period.BeginDate, Mode=TwoWay}" Culture="uk-UA"/>

                <t:Label Grid.Row="2" Grid.Column="0" Content="Дата завершення"/>
                <t:RadDatePicker Grid.Row="2" Grid.Column="1"
                                 SelectedValue="{Binding Period.EndDate, Mode=TwoWay}" Culture="uk-UA"/>
            </Grid>

            <StackPanel Grid.Row="1" FlowDirection="RightToLeft" Orientation="Horizontal" Background="Silver">
                <t:RadButton Content="Скасувати"
                             IsCancel="True"
                             Command="{Binding CloseWindowCommand}"
                             CommandParameter="{Binding ElementName=thisWindow}"/>
                <t:RadButton Content="Зберегти"
                             Command="{Binding SaveCommand}"
                             CommandParameter="{Binding ElementName=thisWindow}"/>
            </StackPanel>
        </Grid>

    </t:RadBusyIndicator>
</Window>
