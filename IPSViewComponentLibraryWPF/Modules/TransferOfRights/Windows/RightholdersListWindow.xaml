<Window x:Class="IPSViewComponentLibraryWPF.Modules.TransferOfRights.Windows.RightholdersListWindow"
        x:Name="thisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Modules.TransferOfRights.Windows"
        xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:IPSViewComponentLibraryWPF.Modules.TransferOfRights.Windows.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="Правовласники" Height="450" Width="800">

    <Window.DataContext>
        <vm:RightholdersListViewModel/>
    </Window.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>
        <Style TargetType="t:RadGridView">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="ShowGroupPanel" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowIndicatorVisibility" Value="Collapsed"/>
            <!--<Setter Property="IsFilteringAllowed" Value="False"/>-->
            <Setter Property="ShowSearchPanel" Value="True"/>
            <Setter Property="SearchPanelCloseButtonVisibility" Value="Hidden"/>
        </Style>
        <Style TargetType="t:GridViewDataColumn">
            <Setter Property="HeaderTextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ShowToolTipOnTrimmedText" Value="True"/>
            <Setter Property="HeaderTextAlignment" Value="Center"/>
        </Style>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinWidth" Value="125"/>
        </Style>
        <Style TargetType="t:RadTabControl">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>
    </Window.Resources>

    <t:RadBusyIndicator t:StyleManager.Theme="VisualStudio2013" IsBusy="{Binding IsBusy}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <t:RadGridView x:Name="radGridView"
                           ItemsSource="{Binding RightholdersItemSource}"
                           IsReadOnly="True"
                           SelectedItem="{Binding SelectedRightholder}"
                           ColumnWidth="*">
                <t:RadGridView.Columns>
                    <t:GridViewDataColumn DataMemberBinding="{Binding CustId}" Width="80" 
                                          IsFilterable="False"
                                          Header="ID"/>
                    <t:GridViewDataColumn DataMemberBinding="{Binding InnerCode}" 
                                          Width="150"
                                          IsFilterable="False"
                                          Header="Шифр автора / правовласника"/>
                    <t:GridViewDataColumn DataMemberBinding="{Binding InterCode}" 
                                          Width="150"
                                          IsFilterable="False"
                                          Header="IPI"/>
                    <t:GridViewDataColumn DataMemberBinding="{Binding Name}" 
                                          IsFilterable="False"
                                          Header="Правовласник"/>
                    <t:GridViewDataColumn DataMemberBinding="{Binding CntObj}" 
                                          Width="95"
                                          TextAlignment="Right"
                                          IsFilterable="False"
                                          Header="К-сть об'єктів"/>
                    <t:GridViewDataColumn DataMemberBinding="{Binding RHolderTypeName}" 
                                          Width="150"
                                          TextAlignment="Center"
                                          IsFilterable="True"
                                          Header="Тип правовласника"/>
                    <t:GridViewDataColumn DataMemberBinding="{Binding CustomerStatusName}"
                                          Width="150"
                                          TextAlignment="Center"
                                          IsFilterable="True"
                                          Header="Статус"/>
                </t:RadGridView.Columns>
            </t:RadGridView>

            <t:RadDataPager Grid.Row="1" DisplayMode="All" t:StyleManager.Theme="VisualStudio2013" Source="{Binding Items, ElementName=radGridView}" PageSize="200" />

            <StackPanel Grid.Row="2" Background="Silver" Orientation="Horizontal" FlowDirection="RightToLeft">
                <t:RadButton Content="Скасувати"
                             IsCancel="True"/>
                <t:RadButton Content="Обрати"
                             Command="{Binding SelectRightholderCommand}"
                             CommandParameter="{Binding ElementName=thisWindow}"/>
            </StackPanel>
        </Grid>
    </t:RadBusyIndicator>
</Window>
