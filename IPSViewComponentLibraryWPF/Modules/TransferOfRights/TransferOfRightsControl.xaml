<UserControl x:Class="IPSViewComponentLibraryWPF.Modules.TransferOfRights.TransferOfRightsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Modules.TransferOfRights"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:controls="clr-namespace:IPSViewComponentLibraryWPF.Modules.TransferOfRights.Views"
             mc:Ignorable="d" 
             Background="WhiteSmoke"
             d:DesignHeight="477" d:DesignWidth="1018">

    <UserControl.DataContext>
        <local:TransferOfRightsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="8,3,3,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="textBlock" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="textBlockDefault" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="t:RadGridView">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="ShowGroupPanel" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowIndicatorVisibility" Value="Collapsed"/>
            <Setter Property="IsFilteringAllowed" Value="False"/>
        </Style>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="160"/>
        </Style>
        <Style TargetType="t:RadComboBox">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="t:RadDatePicker">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="125"/>
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>
    </UserControl.Resources>

    <t:RadBusyIndicator IsBusy="{Binding IsBusy}" t:StyleManager.Theme="VisualStudio2013">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource textBlock}" Text="{Binding LM.TransferType, StringFormat='{}{0}:'}"/>
                <!--not used-->
                <RadioButton Content="{Binding LM.Alienation}"
                             Name="rbAlienation"
                             IsEnabled="False"/>
                <RadioButton Content="{Binding LM.DefaultTransfer}" 
                             IsChecked="True"
                             Name="rbDefaultTransfer"
                             Command="{Binding SelectDefaultTransferCommand}"
                             CommandParameter="{Binding ElementName=defaultTransferView}"/>
                <RadioButton Content="{Binding LM.Heritage}" 
                             Name="rbHeritage"
                             Command="{Binding SelectHeritageTransferCommand}"
                             CommandParameter="{Binding ElementName=defaultTransferView}"/>
                <RadioButton Content="{Binding LM.TransferPubSub}" 
                             Name="rbTransferPubSub"
                             Command="{Binding SelectPubSubTransferCommand}"
                             CommandParameter="{Binding ElementName=publisherSubpublisherTransferView}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <DockPanel Visibility="{Binding DefaultTransferVisibility, Mode=TwoWay}">
                    <controls:DefaultTransferView x:Name="defaultTransferView"/>
                </DockPanel>
                <DockPanel Visibility="{Binding PubSubTransferVisibility, Mode=TwoWay}">
                    <controls:PublisherSubpublisherTransferView x:Name="publisherSubpublisherTransferView"/>
                </DockPanel>
            </Grid>
        </Grid>
    </t:RadBusyIndicator>
</UserControl>
