<UserControl x:Class="IPSViewComponentLibraryWPF.Modules.TransferOfRights.TransferOfRightsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Modules.TransferOfRights"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             Background="WhiteSmoke"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <local:TransferOfRightsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="8,3,3,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="t:RadGridView">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="ShowGroupPanel" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsFilteringAllowed" Value="False"/>
        </Style>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="160"/>
        </Style>
        <Style TargetType="t:RadComboBox">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </UserControl.Resources>

    <t:RadBusyIndicator IsBusy="{Binding IsBusy}" t:StyleManager.Theme="VisualStudio2013">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="{Binding LM.TransferType, StringFormat='{}{0}:'}"/>
                <RadioButton Content="{Binding LM.Alienation}"
                             Name="rbAlienation"
                             Command="{Binding ChangeTransferTypeCommand}" 
                             CommandParameter="{Binding ElementName=rbAlienation}"
                             IsEnabled="False"/>
                <RadioButton Content="{Binding LM.DefaultTransfer}" 
                             Name="rbDefaultTransfer"
                             Command="{Binding ChangeTransferTypeCommand}"
                             CommandParameter="{Binding ElementName=rbDefaultTransfer}"/>
                <RadioButton Content="{Binding LM.Heritage}" 
                             Name="rbHeritage"
                             Command="{Binding ChangeTransferTypeCommand}"
                             CommandParameter="{Binding ElementName=rbHeritage}"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <!--обрати правовласника-->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Правовласник"/>
                    <t:RadDropDownButton t:StyleManager.Theme="VisualStudio2013" Margin="3" Width="250"
                                         Content="{Binding SelectedRightholder.RightholderName}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding SelectRightholderCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </t:RadDropDownButton>
                    <Label Content="dd.mm.yyyy"/>
                    <Label Content="Дохід з початку року:"/>
                    <Label Content="0.00 грн"/>
                    <t:RadButton Content="Анкета" Width="75"/>
                </StackPanel>
                <!--додатковий правовласник-->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Додатково правовласник"/>
                    <t:RadDropDownButton t:StyleManager.Theme="VisualStudio2013" Margin="3" Width="250"
                                         Content="{Binding SelectedRightholderAdd.RightholderName}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding SelectRightholderAddCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </t:RadDropDownButton>
                    <Label Content="dd.mm.yyyy"/>
                    <Label Content="Дохід з початку року:"/>
                    <Label Content="0.00 грн"/>
                    <t:RadButton Content="Анкета" Width="75"/>
                </StackPanel>
            </StackPanel>

            <t:RadGridView Grid.Row="2"
                           SelectionMode="Multiple"
                           IsReadOnly="True"
                           ItemsSource="{Binding ObjectsRightItemSource}"
                           ColumnWidth="*"
                           >
                <t:RadGridView.Columns>
                    <t:GridViewDataColumn Width="100" Header="Шифр твору" DataMemberBinding="{Binding ObjId}"/>
                    <t:GridViewDataColumn Width="250" Header="Назва твору" DataMemberBinding="{Binding Name}"/>
                    <t:GridViewDataColumn Header=" В/М" DataMemberBinding="{Binding Category}"/>
                    <t:GridViewDataColumn Header="Жанр" DataMemberBinding="{Binding GenreName}"/>
                    <t:GridViewDataColumn Header="Час" DataMemberBinding="{Binding Duration}"/>
                    <t:GridViewDataColumn Header="Творчий профіль" DataMemberBinding="{Binding RoleName}"/>
                    <t:GridViewDataColumn Header="Переклад / обробка / оригінал" DataMemberBinding="{Binding SpecName}"/>
                    <t:GridViewDataColumn Header="Спільний % володіння" DataMemberBinding="{Binding RateTotal, StringFormat='{}{0:N2}'}"/>
                    <t:GridViewDataColumn Header="Його % володіння" DataMemberBinding="{Binding RateRh, StringFormat='{}{0:N2}'}"/>
                    <t:GridViewDataColumn Header="Виконавець" DataMemberBinding="{Binding Performer}"/>
                    <t:GridViewDataColumn Header="Дохід з початку року" DataMemberBinding="{Binding Profit,  StringFormat='{}{0:N2}'}"/>
                    <t:GridViewColumn MinWidth="35" Width="35">
                        <t:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <t:RadButton Background="Transparent" BorderThickness="0" Margin="-2,0,-2,0" Width="30" Height="25" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                             Command="{Binding DataContext.ViewObjectRightCommand, RelativeSource={RelativeSource AncestorType={x:Type t:RadGridView}}}"
                                             CommandParameter="{Binding}">
                                    <Image Source="../../Resources/Icons/edit-icon.png" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </t:RadButton>
                            </DataTemplate>
                        </t:GridViewColumn.CellTemplate>
                    </t:GridViewColumn>
                </t:RadGridView.Columns>
            </t:RadGridView>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <t:RadButton Grid.Column="0" Content="Перенести всі"/>
                <t:RadButton Grid.Column="1" Content="Перенести обрані"/>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <Label Content="З якої дати: "/>
                <t:RadDatePicker t:StyleManager.Theme="VisualStudio2013" Width="100" Margin="3"/>
                <Label Content="по"/>
                <t:RadDatePicker t:StyleManager.Theme="VisualStudio2013" Width="100" Margin="3"/>
            </StackPanel>

            <t:RadGridView x:Name="RadGridView" 
                           Grid.Row="5"
                           ItemsSource="{Binding SelectedObjectsRightItemSource}"
                           AutoGenerateColumns="False"
                           GroupRenderMode="Flat"
                           ShowToolTipOnTrimmedText="True">

                <t:RadGridView.ChildTableDefinitions>
                    <t:GridViewTableDefinition>
                        <t:GridViewTableDefinition.Relation>
                            <t:PropertyRelation ParentPropertyName="Rightholders"/>
                        </t:GridViewTableDefinition.Relation>
                    </t:GridViewTableDefinition>
                </t:RadGridView.ChildTableDefinitions>

                <t:RadGridView.Columns>
                    <!--<t:GridViewToggleRowDetailsColumn/>-->
                    <t:GridViewDataColumn Header="Творча роль" DataMemberBinding="{Binding RoleName}"/>
                    <t:GridViewDataColumn Header="Назва об'єкта" DataMemberBinding="{Binding Name}"/>
                    <t:GridViewDataColumn Header="% володіння" DataMemberBinding="{Binding RateRh}"/>
                    <!--обрати-->
                    <t:GridViewColumn Width="75" ShowToolTipOnTrimmedText="True">
                        <t:GridViewColumn.Header>
                            <CheckBox x:Name="headerCheckBox"
                                      Content="Ручне редагування відсотка"
                                      FontWeight="SemiBold"
                                      IsChecked="{Binding Path=DataContext.IsAllCheck, RelativeSource={RelativeSource AncestorType=t:RadGridView}}">
                            </CheckBox>
                        </t:GridViewColumn.Header>
                        <t:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding ManualDistribution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </t:GridViewColumn.CellTemplate>
                    </t:GridViewColumn>
                    <!--видалити-->
                    <t:GridViewColumn MinWidth="35" Width="35">
                        <t:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <t:RadButton Background="Transparent" BorderThickness="0" Margin="-2,0,-2,0" Width="30" Height="25" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                             Command="{Binding DataContext.RemoveObjectRightCommand, RelativeSource={RelativeSource AncestorType={x:Type t:RadGridView}}}"
                                             CommandParameter="{Binding}">
                                    <Image Source="../../Resources/Icons/delete-icon.png" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </t:RadButton>
                            </DataTemplate>
                        </t:GridViewColumn.CellTemplate>
                    </t:GridViewColumn>
                </t:RadGridView.Columns>

                <t:RadGridView.HierarchyChildTemplate>
                    <DataTemplate>
                        <t:RadGridView x:Name="RadGridView"
                                       BorderThickness="0,1,0,1"
                                       ItemsSource="{Binding Rightholders}">
                            <t:RadGridView.Columns>
                                <t:GridViewDataColumn Header="Шифр правовласника" DataMemberBinding="{Binding RightholderCode}"/>
                                <t:GridViewDataColumn Header="IPI" DataMemberBinding="{Binding IPI}"/>
                                <t:GridViewDataColumn Header="Правовласник" DataMemberBinding="{Binding RightholderName}"/>
                                <t:GridViewDataColumn Header="% володіння" DataMemberBinding="{Binding RightholderRate, StringFormat='{}{0:N2}'}"/>
                            </t:RadGridView.Columns>
                        </t:RadGridView>
                    </DataTemplate>
                </t:RadGridView.HierarchyChildTemplate>
            </t:RadGridView>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <t:RadButton Grid.Column="0" Content="Додати правонаступника" HorizontalAlignment="Left"/>
                <t:RadButton Grid.Column="1" Content="Очистити" HorizontalAlignment="Right"/>
                <t:RadButton Grid.Column="2" Content="Зберегти" HorizontalAlignment="Right"/>
            </Grid>

        </Grid>
    </t:RadBusyIndicator>
</UserControl>
