<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Properties"
                    xmlns:t="http://schemas.telerik.com/2008/xaml/presentation">

    <Style TargetType="t:RadGridView">
        <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="RowIndicatorVisibility" Value="Collapsed"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="AllowDrop" Value="False"/>
        <Setter Property="ShowGroupPanel" Value="False"/>
        <Setter Property="IsFilteringAllowed" Value="False"/>
    </Style>
    <Style TargetType="t:GridViewHeaderCell">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style TargetType="t:Label">
        <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>

    </Style>

    <Style TargetType="t:RadButton">
        <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
    </Style>

    <Style TargetType="t:RadDropDownButton">
        <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
    </Style>

</ResourceDictionary>