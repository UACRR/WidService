<UserControl x:Class="IPSViewComponentLibraryWPF.Controls.ItemsCountControl.ItemsCountControl"
             x:Name="this"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Background="WhiteSmoke"
             xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Controls.ItemsCountControl"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d">

    <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <t:RadDataPager Grid.Column="0"
                        Margin="3 0"
                        BorderThickness="0"
                        x:Name="DataPager"
                        PageSize="250"
                        Source="{Binding Items, ElementName=gridView}"
                        IsTotalItemCountFixed="False"
                        DisplayMode="All, All"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Margin="5 0 0 0" Content="К-сть на сторінку:"/>

            <TextBox Text="{Binding ElementName=DataPager, Path=PageSize, Mode=TwoWay, StringFormat='{}{0:N0}'}"
                     VerticalContentAlignment="Center"
                     MaxLength="5"
                     HorizontalContentAlignment="Right"
                     MinWidth="50"
                     Margin="3"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Margin="10 0" Content="К-сть записів:"/>
            <Label Margin="0 0 10 0" Content="{Binding ElementName=DataPager, Path=ItemCount}"/>
        </StackPanel>
    </Grid>
</UserControl>
