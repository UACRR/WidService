<UserControl x:Class="IPSViewComponentLibraryWPF.Controls.SearchControl.SearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSViewComponentLibraryWPF.Controls.SearchControl"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             Background="WhiteSmoke"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <local:SearchControlViewModel/>
    </UserControl.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="ListBox" >
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="false"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TabControl>
            <TabItem Header="{Binding LM_SEARCH.TAB_SIMPLE}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Margin="3" Background="AliceBlue">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >
                            <TextBox Text="{Binding SimpleSearchParameters.SearchText}"
                                 Margin="3" 
                                 VerticalContentAlignment="Center" 
                                 MinWidth="250"/>
                            <t:RadButton Content="{Binding LM_SEARCH.BTN_SEARCH}"
                                     MinWidth="95" 
                                     Command="{Binding RunSearchCommand}">
                            </t:RadButton>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Margin="5 0" 
                                         IsChecked="{Binding SimpleSearchParameters.IsEqualSelected}" 
                                         Content="{Binding LM_SEARCH.EQ_VAL}" 
                                         VerticalAlignment="Center"/>
                                <RadioButton Margin="5 0" 
                                         IsChecked="{Binding SimpleSearchParameters.IsLikeSelected}" 
                                         Content="{Binding LM_SEARCH.LIKE_VAL}"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <t:RadButton Grid.Column="1" 
                                     MinWidth="80" 
                                     HorizontalAlignment="Right" 
                                     Content="Clear"
                                     Command="{Binding ClearCommand}"/>
                    </Grid>

                    <t:Label Grid.Row="1"
                             Background="GhostWhite"
                             Content="{Binding LM_SEARCH.CHECK_SEARCH_ENUM}"/>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <ListBox Margin="3" ItemsSource="{Binding ListBoxItemsSource}">
                            <ListBox.Template>
                                <ControlTemplate>
                                    <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding LM_SEARCH.TAB_MULTI}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="{Binding LM_SEARCH.TXT_SEARCH_ENUM}" Background="GhostWhite"/>
                            <t:RadButton Grid.Column="1" 
                                         MinWidth="80" 
                                         HorizontalAlignment="Right" 
                                         Content="Clear"
                                         Command="{Binding ClearCommand}"/>
                        </Grid>

                        <ListBox Grid.Row="1" 
                                 Margin="3" 
                                 Focusable="False"
                                 IsTabStop="false" 
                                 ItemsSource="{Binding ListBoxExtendedItemsSource}" 
                                 HorizontalAlignment="Stretch" 
                                 HorizontalContentAlignment="Stretch"
                                 IsSelected="False"
                                 Grid.ColumnSpan="2">
                            <ListBox.Template>
                                <ControlTemplate>
                                    <StackPanel IsItemsHost="True"/>
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>

                        <t:RadButton Grid.Row="2" 
                                     Content="{Binding LM_SEARCH.BTN_SEARCH}" 
                                     HorizontalAlignment="Left"
                                     MinWidth="95"
                                     Command="{Binding RunSearchExtendedCommand}"/>

                        <!--<Grid Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <t:RadButton Grid.Column="1" 
                                         Content="{Binding LM_SEARCH.BTN_SEARCH}" 
                                         MinWidth="95"
                                         Command="{Binding RunSearchExtendedCommand}"/>
                        </Grid>-->


                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
