<UserControl x:Class="IPSModulesLibrary.PaymentToRightholder.PaymentToRightholderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.PaymentToRightholder"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             Background="WhiteSmoke"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="redButton" TargetType="Button">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="MinHeight" Value="33.5"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Foreground" Value="GhostWhite"/>
            <Setter Property="Padding" Value="8 3 5 8"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="Red" BorderBrush="Silver" BorderThickness="0,1,1,0" >
                            <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="#E10000" BorderBrush="#E10000" BorderThickness="0,1,1,0" >
                                    <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#32077d"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="#BD0000" BorderBrush="#BD0000" BorderThickness="0,1,1,0" >
                                    <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="updateButton" TargetType="Button">
            <Setter Property="Content">
                <Setter.Value>
                    <Image Source="../Resources/Icons/update-icon.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#7AD3FF"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ToolTip" Value="Update"/>
        </Style>

        <Style x:Key="categoryStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f5f5f5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="textBlockButtons" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Gray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <WrapPanel  ItemHeight="280" ItemWidth="280" Orientation="Horizontal"  HorizontalAlignment="Center" Margin="0, 20" >
            <Border Style="{StaticResource categoryStyle}" Margin="25" CornerRadius="10"  Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.3"></DropShadowEffect>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCategoryCommand}" CommandParameter="all"/>
                </Border.InputBindings>
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Разбор принятых '.dbf' по оплате роялти правообладателями (по этой кнопке  открыть грид hidden)"
                                       Style="{StaticResource textBlockButtons}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource categoryStyle}" Margin="25" CornerRadius="10"  Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.3"></DropShadowEffect>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCategoryCommand}" CommandParameter="all"/>
                </Border.InputBindings>
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Ручной ввод снятия роялти правообладателями (по этой кнопке  открыть грид hidden)"
                                       Style="{StaticResource textBlockButtons}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </WrapPanel>

        <!--Разбор принятых '.dbf' по оплате роялти правообладателями-->
        <Grid Margin="20 0" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 20 0 0">
                <TextBlock FontWeight="Bold" Text="Завантаження та обробка файлу .dbf "></TextBlock>
            </Grid>

            <Grid Grid.Row="1" Margin="0 10">
                <WrapPanel>
                    <t:RadButton Margin="0 0 20 0"
                                             Content="Виберіть файл" 
                                             MinWidth="100" Padding="5,5,5,9" UseLayoutRounding="True"/>
                    <TextBlock Text="файл не выбран" VerticalAlignment="Center"></TextBlock>
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0 10 0 10">
                <TextBlock FontWeight="Bold" Text="Розбір не прив'язаних платежів "></TextBlock>
            </Grid>


            <t:RadGridView Grid.Row="3"
                               ColumnWidth="*"
                               Margin="3">
                <t:RadGridView.Columns>
                    <t:GridViewDataColumn Width="110" 
                                              Header="Номер рахунку" 
                                              />

                    <t:GridViewDataColumn Width="100" 
                                                        Header="МФО"/>

                    <t:GridViewDataColumn Width="100" 
                                              Header="ЄДРПОУ"
                                              />
                    <t:GridViewDataColumn  
                                              Header="Назва користувача"
                                              />


                    <t:GridViewDataColumn Width="125" 
                                              Header="Номер платежу" />

                    <t:GridViewDataColumn Width="125" 
                                              Header="Сума"
                                              />
                    <t:GridViewDataColumn 
                                              Header="Призначення платежу" 
                                              />

                    <t:GridViewDataColumn Header="Дата платежу" 
                                              Width="75"
                                              />
                    <t:GridViewColumn Width="25">
                        <t:GridViewColumn.Header>
                            <Image Width="20" Height="20" Source="../Resources/Icons/edit-icon.png"/>
                        </t:GridViewColumn.Header>
                        <t:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <t:RadButton Margin="0" Width="25" Height="20" 
                                                 Command="{Binding DataContext.OpenPartnerCommand, RelativeSource={RelativeSource AncestorType={x:Type t:RadGridView}}}"
                                                 CommandParameter="{Binding}">
                                    <Image Source="../Resources/Icons/edit-icon.png"/>
                                </t:RadButton>
                            </DataTemplate>
                        </t:GridViewColumn.CellTemplate>
                    </t:GridViewColumn>
                </t:RadGridView.Columns>
            </t:RadGridView>
        </Grid>

        <!--Ручной ввод снятия роялти правообладателями-->
        <Grid MaxWidth="500" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 20 0 10">
                <TextBlock TextAlignment="Center" FontWeight="Bold" Text="Ручной ввод снятия роялти правообладателями "></TextBlock>
            </Grid>

            <Grid Grid.Row="1" Margin="0 10">
                <WrapPanel>
                    <TextBox Height="33.5" Margin="0 0 10 0" Width="380"></TextBox>
                    <t:RadButton Margin="8 0 0 0"
                                             Content="Пошук" 
                                             MinWidth="100" Padding="5,5,5,9" UseLayoutRounding="True"/>
                </WrapPanel>
            </Grid>


            <t:RadGridView Grid.Row="2"
                               ColumnWidth="*"
                               Margin="0 5 0 10">
                <t:RadGridView.Columns>
                    <t:GridViewDataColumn Width="75"
                                                      Header="Код" />

                    <t:GridViewDataColumn 
                                                      Header="ФИО/название правообладателя"/>

                    <t:GridViewDataColumn Width="120" 
                                                      Header="Остаток на счете правообладателя"/>
                    <t:GridViewDataColumn Width="120" 
                                                      Header="Введите суму снятия">
                    </t:GridViewDataColumn>
                </t:RadGridView.Columns>
            </t:RadGridView>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="3" Margin="0 50 0 0">
                <t:RadButton HorizontalAlignment="Right"
                                         Content="Выполнить" 
                                         MinWidth="100" Padding="5,5,5,9" Margin="0 0 20 0" UseLayoutRounding="True"/>

                <t:RadButton HorizontalAlignment="Right"
                                         Content="Отменить" 
                                         MinWidth="100" Padding="5,5,5,9" UseLayoutRounding="True"/>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
