<UserControl x:Class="IPSModulesLibrary.RightholdersList.RightholdersListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.RightholdersList"
             mc:Ignorable="d" 
             Background="WhiteSmoke"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DockPanel LastChildFill="True">
            <StackPanel Background="LightGray" DockPanel.Dock="Bottom" Orientation="Horizontal" Height="30">
                <TextBlock>Test</TextBlock>
            </StackPanel>
            <Border BorderBrush="Black" DockPanel.Dock="Left" BorderThickness="1">
                <StackPanel MinWidth="150">
                    <TextBlock Margin="5,5,5,5" FontSize="14">Test</TextBlock>
                    <TextBlock Margin="5,5,5,5" FontSize="14">Test</TextBlock>
                    <TextBlock Margin="5,5,5,5" FontSize="14">Test</TextBlock>
                    <TextBlock Margin="5,5,5,5" FontSize="14">Test</TextBlock>
                    <TextBlock Margin="5,5,5,5" FontSize="14">Test</TextBlock>
                </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBlock>Search</TextBlock>
            </StackPanel>
        </DockPanel>
        <Grid ></Grid>
    </Grid>
</UserControl>
