<UserControl x:Class="IPSModulesLibrary.ResourceControl.ResourceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.ResourceControl"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             Background="WhiteSmoke"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Control.Resources>
        <Style TargetType="t:RadButton">
            <Setter Property="Background" Value="#470fa9"/>
            <Setter Property="MinHeight" Value="33.5"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8 3 5 8"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="#470fa9" BorderBrush="#470fa9" BorderThickness="0,1,1,0" >
                            <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#611ed6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="t:RadComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="33.5"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Padding" Value="8 3 8 8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="t:RadComboBox" x:Key="dropdownBtn" >
            <Setter Property="Background" Value="#470fa9"/>

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinHeight" Value="33.5"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Padding" Value="8 3 8 8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="t:RadComboBox">
                        <Border CornerRadius="10" Background="#470fa9" BorderBrush="#470fa9" BorderThickness="0,1,1,0" >
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="dropdownText" >
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MaxHeight" Value="33.5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="labelText" >
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MaxHeight" Value="33.5"/>
            <Setter Property="Foreground" Value="#a0a0a0"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="dropdownBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0 6 15 5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

    </Control.Resources>

    <Grid>
        <StackPanel Margin="20">
            <t:RadButton HorizontalAlignment="Left"
                         Content="Button" 
                         MinWidth="100" Click="RadButton_Click" Padding="5,5,5,9" UseLayoutRounding="True"/>

                <t:RadComboBox Style="{DynamicResource dropdownBtn}"
                           HorizontalAlignment="Left" 
                           Margin="0 20 0 0" Width="100">
                    <t:RadComboBoxItem Content="Save"/>
                    <t:RadComboBoxItem Content="Save 2 3 4"/>
                </t:RadComboBox>

            <t:RadComboBox HorizontalAlignment="Left" 
                           Margin="0 20 0 20" Width="200"
                           IsEditable="True"
                           IsReadOnly="True"
                           Text="Додати правовласника" 
                           />



            <WrapPanel>
                <TextBlock Style="{DynamicResource dropdownBlock}">Додати правовласника:</TextBlock>
                <t:RadComboBox HorizontalAlignment="Left" 
                            Width="200"
                           />
            </WrapPanel>


            <StackPanel HorizontalAlignment="Left"  >

                <StackPanel Orientation="Horizontal" MaxHeight="33.5" Margin="0 20 0 0">
                    <Border CornerRadius="3" Width="25" Height="25">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                <GradientStop Color="#8F41F8"/>
                                <GradientStop Color="#B025D8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image Width="13" Height="13" Source="../Resources/Icons/chart1.png"/>
                        </Grid>
                    </Border>
                    <TextBlock Margin="8 0 0 0" Text="Label" Style="{DynamicResource labelText}" VerticalAlignment="Center" FontFamily="Calibri" FontSize="18"  />
                </StackPanel>

                <StackPanel Orientation="Horizontal" MaxHeight="33.5" Margin="0 20 0 0">
                    <Border CornerRadius="3" Width="25" Height="25">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                <GradientStop Color="#F2994A"/>
                                <GradientStop Color="#F2C94C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image Width="13" Height="13" Source="../Resources/Icons/connection-1.png"/>
                        </Grid>
                    </Border>
                    <TextBlock Margin="8 0 0 0" Text="Label" Style="{DynamicResource labelText}" VerticalAlignment="Center" FontFamily="Calibri" FontSize="18"  />
                </StackPanel>
               
                <StackPanel Orientation="Horizontal" MaxHeight="33.5" Margin="0 20 0 0">
                    <Border CornerRadius="3" Width="25" Height="25">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                <GradientStop Color="#EA715E"/>
                                <GradientStop Color="#D3417F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image Width="13" Height="13" Source="../Resources/Icons/target.png"/>
                        </Grid>
                    </Border>
                    <TextBlock Margin="8 0 0 0" Text="Label" Style="{DynamicResource labelText}" VerticalAlignment="Center" FontFamily="Calibri" FontSize="18"  />
                </StackPanel>
             
                <StackPanel Orientation="Horizontal" MaxHeight="33.5" Margin="0 20 0 0">
                    <Border CornerRadius="3" Width="25" Height="25">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                <GradientStop Color="#41EDF8"/>
                                <GradientStop Color="#35E4EF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image Width="13" Height="13" Source="../Resources/Icons/promotion-1.png"/>
                        </Grid>
                    </Border>
                    <TextBlock Margin="8 0 0 0" Text="Label" Style="{DynamicResource labelText}" VerticalAlignment="Center" FontFamily="Calibri" FontSize="18"  />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" MaxHeight="33.5" Margin="0 20 0 0">
                    <Border CornerRadius="3" Width="25" Height="25">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                <GradientStop Color="#FF7E9D"/>
                                <GradientStop Color="#EA5EB2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image Width="13" Height="13" Source="../Resources/Icons/backlink-1.png"/>
                        </Grid>
                    </Border>
                    <TextBlock Margin="8 0 0 0" Text="Label" Style="{DynamicResource labelText}" VerticalAlignment="Center" FontFamily="Calibri" FontSize="18"  />
                </StackPanel>
            </StackPanel>

            
        </StackPanel>

        
        
    </Grid>
</UserControl>