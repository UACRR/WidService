<UserControl x:Class="IPSModulesLibrary.ResourceControl.ResourceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.ResourceControl"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             Background="WhiteSmoke"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Control.Resources>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>
    </Control.Resources>
    
    <Grid>
        <StackPanel>
            <t:RadButton HorizontalAlignment="Left"
                         Content="Button" 
                         MinWidth="100"/>
        </StackPanel>
    </Grid>
</UserControl>
