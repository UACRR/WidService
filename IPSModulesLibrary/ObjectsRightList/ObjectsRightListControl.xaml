<UserControl x:Class="IPSModulesLibrary.ObjectsRightList.ObjectsRightListControl"
             x:Name="thisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:search="clr-namespace:IPSViewComponentLibraryWPF.Controls.SearchControl;assembly=IPSViewComponentLibraryWPF"
             xmlns:local="clr-namespace:IPSModulesLibrary.ObjectsRightList"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             Background="WhiteSmoke"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.DataContext>
        <local:ObjectsRightListViewModel/>
    </Control.DataContext>

    <Control.Resources>
        <Style TargetType="t:RadTreeViewItem">
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="t:RadGridView">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="ShowGroupPanel" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ShowSearchPanel" Value="True"/>
            <Setter Property="SearchPanelCloseButtonVisibility" Value="Collapsed"/>
        </Style>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>
        <Style TargetType="t:RadExpander">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>
        <Style TargetType="t:RadTreeView">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>
        <Style TargetType="t:GridViewDataColumn">
            <Setter Property="HeaderTextAlignment" Value="Center"/>
            <Setter Property="IsFilterable" Value="False"/>
        </Style>
    </Control.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding ElementName=thisControl}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <t:RadBusyIndicator t:StyleManager.Theme="VisualStudio2013"
                        IsBusy="{Binding IsBusy}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <t:RadTreeView MinWidth="100"
                               Margin="3"
                               Background="MintCream"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch"
                               ItemsSource="{Binding TreeViewItemSource}"
                               SelectionMode="Single"
                               SelectedItem="{Binding Path=SelectedTreeViewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <GridSplitter Grid.Column="1"
                              Margin="0,3,0,3"
                              HorizontalAlignment="Stretch"
                              Width="3" Background="Silver" ShowsPreview="False"/>

                <Grid Grid.Column="2" Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <search:SearchControl Grid.Row="0" x:Name="searchControl"/>

                    <t:RadGridView Grid.Row="1"
                                   x:Name="gridView"
                                   ItemsSource="{Binding ObjectsRightsItemSource}"
                                   Margin="3">
                        <t:RadGridView.Columns>
                            <t:GridViewDataColumn Width="75" Header="ID" DataMemberBinding="{Binding ObjId}"/>
                            <t:GridViewDataColumn Width="1*" Header="{Binding LOC.GV_IN_CODE}" DataMemberBinding="{Binding InnerCode}"/>
                            <t:GridViewDataColumn Width="85" Header="ISWC" DataMemberBinding="{Binding ISWC}"/>
                            <t:GridViewDataColumn Width="1*" Header="{Binding LOC.GV_OBJ_NAME}" DataMemberBinding="{Binding Name}"/>
                            <t:GridViewDataColumn Width="25" Header="{Binding LOC.GV_BS_CAT_NAME}" 
                                                  IsFilterable="True"
                                                  ToolTip="{Binding LOC.GVTT_BS_CAT_NAME}" 
                                                  DataMemberBinding="{Binding CategoryName}" 
                                                  TextAlignment="Center"/>
                            <t:GridViewDataColumn Width="1*" 
                                                  Header="{Binding LOC.GV_GENRE}" 
                                                  IsFilterable="True"
                                                  DataMemberBinding="{Binding GenreName}"/>

                            <t:GridViewDataColumn Width="1*" 
                                                  Header="{Binding LOC.GV_AUTHOR}" 
                                                  ShowToolTipOnTrimmedText="True"
                                                  DataMemberBinding="{Binding Author}"/>
                            <t:GridViewDataColumn Width="1*" 
                                                  Header="{Binding LOC.GV_PERFORMER}" 
                                                  ShowToolTipOnTrimmedText="True"
                                                  DataMemberBinding="{Binding Performer}"/>
                            <t:GridViewDataColumn Width="75" 
                                                  ShowToolTipOnTrimmedText="True" 
                                                  Header="{Binding LOC.GV_RATE}" 
                                                  DataMemberBinding="{Binding RateTotal}"
                                                  DataFormatString="{}{0:N2}"
                                                  TextAlignment="Right"/>
                            <t:GridViewDataColumn Width="120" 
                                                  Header="{Binding LOC.GV_UNDISTRIB_MONEY}" 
                                                  TextAlignment="Right" 
                                                  DataFormatString="{}{0:N2}"
                                                  DataMemberBinding="{Binding Rest}"/>

                            <t:GridViewColumn Width="25">
                                <t:GridViewColumn.Header>
                                    <Image Width="20" Height="20" Source="../Resources/Icons/edit-icon.png"/>
                                </t:GridViewColumn.Header>
                                <t:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <t:RadButton Margin="0" Width="25" Height="20" 
                                                     Command="{Binding DataContext.OpenObjectRightCommand, RelativeSource={RelativeSource AncestorType={x:Type t:RadGridView}}}"
                                                     CommandParameter="{Binding}">
                                            <Image Source="../Resources/Icons/edit-icon.png"/>
                                        </t:RadButton>
                                    </DataTemplate>
                                </t:GridViewColumn.CellTemplate>
                            </t:GridViewColumn>
                        </t:RadGridView.Columns>
                    </t:RadGridView>

                    <Grid Grid.Row="2"> 
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                            <t:RadDataPager Grid.Column="0"
                                            Margin="3 0"
                                            BorderThickness="0"
                                            x:Name="DataPager"
                                            t:StyleManager.Theme="VisualStudio2013"
                                            PageSize="250"
                                            Source="{Binding Items, ElementName=gridView}"
                                            IsTotalItemCountFixed="False"
                                            DisplayMode="All, All"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Label Margin="5 0 0 0" Content="К-сть на сторінку:"/>

                                <TextBox Text="{Binding ElementName=DataPager, Path=PageSize, Mode=TwoWay, StringFormat='{}{0:N0}'}"
                                         VerticalContentAlignment="Center"
                                         MaxLength="5"
                                         HorizontalContentAlignment="Right"
                                         MinWidth="50"
                                         Margin="3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Label Margin="10 0" Content="К-сть записів:"/>
                                <Label Margin="0 0 10 0" Content="{Binding ElementName=DataPager, Path=ItemCount}"/>
                            </StackPanel>
                    </Grid>
                </Grid>


            </Grid>

            <StackPanel Grid.Row="1" Background="Silver">
                <t:RadButton MinWidth="100"
                             HorizontalAlignment="Left"
                             Content="{Binding LOC.BTN_CREATE_OBJ}"
                             Margin="3"
                             Command="{Binding CreateObjectRightCommand}"/>
            </StackPanel>

        </Grid>

    </t:RadBusyIndicator>
</UserControl>
