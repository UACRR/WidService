<UserControl x:Class="IPSModulesLibrary.ObjectsRightList.ObjectsRightListControl"
             x:Name="thisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:search="clr-namespace:IPSViewComponentLibraryWPF.Controls.SearchControl;assembly=IPSViewComponentLibraryWPF"
             xmlns:local="clr-namespace:IPSModulesLibrary.ObjectsRightList"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             Background="WhiteSmoke"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.DataContext>
        <local:ObjectsRightListViewModel/>
    </Control.DataContext>

    <Control.Resources>
        <Style TargetType="t:RadTreeViewItem">
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="t:RadGridView">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="ShowGroupPanel" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsFilteringAllowed" Value="False"/>
            <Setter Property="ShowSearchPanel" Value="True"/>
            <Setter Property="SearchPanelCloseButtonVisibility" Value="Collapsed"/>
        </Style>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>
        <Style TargetType="t:RadExpander">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>
    </Control.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding ElementName=thisControl}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <t:RadBusyIndicator t:StyleManager.Theme="VisualStudio2013"
                        IsBusy="{Binding IsBusy}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <t:RadTreeView t:StyleManager.Theme="VisualStudio2013"
                               MinWidth="100"
                               Margin="3"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch"
                               ItemsSource="{Binding TreeViewItemSource}"
                               SelectionMode="Single"
                               SelectedItem="{Binding Path=SelectedTreeViewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <GridSplitter Grid.Column="1"
                              Margin="0,3,0,3"
                              Width="3" Background="Silver" ShowsPreview="False"/>

                <Grid Grid.Column="2" Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>


                    <t:RadExpander Header="Extended search" IsExpanded="True">
                        <search:SearchControl x:Name="searchControl"/>
                    </t:RadExpander>
                        
                    <t:RadGridView Grid.Row="1"
                                   Margin="3">
                    </t:RadGridView>
                </Grid>


            </Grid>

            <StackPanel Grid.Row="1" Background="Silver">
                <t:RadButton MinWidth="100"
                             HorizontalAlignment="Left"
                             Content="Додати" 
                             Margin="3"/>
            </StackPanel>

        </Grid>

    </t:RadBusyIndicator>
</UserControl>
