<UserControl x:Class="IPSModulesLibrary.ReportsBRList.LicenseBRListControl"
             x:Name="thisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.ReportsBRList"
             xmlns:search="clr-namespace:IPSViewComponentLibraryWPF.Controls.SearchControl;assembly=IPSViewComponentLibraryWPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             Background="WhiteSmoke"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.DataContext>
        <local:LicenseBRListViewModel/>
    </Control.DataContext>

    <Control.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/GridViewResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/StyleManagerResoureDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Control.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding ElementName=thisControl}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <t:RadBusyIndicator IsBusy="{Binding IsBusy}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <search:SearchControl Grid.Row="0" x:Name="searchControl"/>

            <StackPanel Grid.Row="1" Margin="3 1" Orientation="Horizontal">
                <CheckBox Margin="3" Content="Показувати деталі обраного рядка" IsChecked="{Binding IsShowRowDetails}"/>
            </StackPanel>

            <t:RadGridView Grid.Row="2"
                           x:Name="gridView"
                           ColumnWidth="*"
                           IsReadOnly="True"
                           CanUserSearchInHiddenColumns="True"
                           RowDetailsVisibilityMode="{Binding RowDetailsVisibilityMode}"
                           ItemsSource="{Binding ReportsItemSource}"
                           Margin="3">
                <t:RadGridView.Columns>
                    <t:GridViewDataColumn IsVisible="False" DataMemberBinding="{Binding CustId}"/>
                    <t:GridViewDataColumn Header="Назва користувача" 
                                          DataMemberBinding="{Binding Name}"/>

                    <t:GridViewDataColumn Width="75" Header="ID вистави" DataMemberBinding="{Binding Objid}"/>
                    <t:GridViewDataColumn Header="Назва вистави" DataMemberBinding="{Binding ObjName}"/>
                    
                    <t:GridViewDataColumn IsVisible="False" DataMemberBinding="{Binding LicId}"/>

                    <t:GridViewDataColumn Width="125" Header="№ ЛД" DataMemberBinding="{Binding LicNum}"/>
                    <t:GridViewDataColumn Width="115" Header="Дата ЛД" 
                                          IsFilterable="True" 
                                          TextAlignment="Center" 
                                          ShowDistinctFilters="False"
                                          DataMemberBinding="{Binding LicDate, StringFormat='{}{0:d}'}"/>

                    <t:GridViewDataColumn Width="115" Header="Дата прем'єри" 
                                          TextAlignment="Center" 
                                          IsFilterable="True"
                                          ShowDistinctFilters="False"
                                          DataMemberBinding="{Binding DatePremiere, StringFormat='{}{0:d}'}"/>

                    <t:GridViewDataColumn Width="125" 
                                          Header="Стан" 
                                          IsFilterable="True"
                                          ShowFieldFilters="False"
                                          DataMemberBinding="{Binding LicTypeName}"/>
                    <t:GridViewDataColumn Width="125" 
                                          Header="Статус" 
                                          IsFilterable="True"
                                          ShowFieldFilters="False"
                                          DataMemberBinding="{Binding LicStatusName}"/>

                    <t:GridViewColumn Width="25">
                        <t:GridViewColumn.Header>
                            <Image Width="20" Height="20" Source="../Resources/Icons/view-icon.png"/>
                        </t:GridViewColumn.Header>
                        <t:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <t:RadButton Margin="0" Width="25" Height="20" 
                                             Command="{Binding DataContext.OpenLicenseCommand, RelativeSource={RelativeSource AncestorType={x:Type t:RadGridView}}}"
                                             CommandParameter="{Binding}">
                                    <Image Source="../Resources/Icons/view-icon.png"/>
                                </t:RadButton>
                            </DataTemplate>
                        </t:GridViewColumn.CellTemplate>
                    </t:GridViewColumn>

                    <t:GridViewColumn Width="25">
                        <t:GridViewColumn.Header>
                            <Image Width="20" Height="20" Source="../Resources/Icons/edit-icon.png"/>
                        </t:GridViewColumn.Header>
                        <t:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <t:RadButton Margin="0" Width="25" Height="20" 
                                             Command="{Binding DataContext.EditLicenseCommand, RelativeSource={RelativeSource AncestorType={x:Type t:RadGridView}}}"
                                             CommandParameter="{Binding}">
                                    <Image Source="../Resources/Icons/edit-icon.png"/>
                                </t:RadButton>
                            </DataTemplate>
                        </t:GridViewColumn.CellTemplate>
                    </t:GridViewColumn>
                </t:RadGridView.Columns>
                <t:RadGridView.RowDetailsTemplate>
                    <DataTemplate>
                        <StackPanel Margin="20 5" Orientation="Vertical">
                            <StackPanel Margin="5" Orientation="Horizontal" >
                                <TextBlock Text="ID користувача: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding CustId}"/>

                                <TextBlock Margin="10 0 0 0" Text="ID ліцензії: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding LicId}"/>

                                <TextBlock Margin="10 0 0 0" Text="Дата початку ліцензії: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding LicDateBegin, StringFormat='{}{0:d}'}"/>
                                
                                <TextBlock Margin="10 0 0 0" Text="Дата завершення ліцензії: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding LicDateEnd, StringFormat='{}{0:d}'}"/>
                            </StackPanel>
                            <StackPanel Margin="5" Orientation="Horizontal">
                                <TextBlock Text="Коментар: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding Comment}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </t:RadGridView.RowDetailsTemplate>
            </t:RadGridView>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <t:RadDataPager Grid.Column="0"
                                Margin="3 0"
                                BorderThickness="0"
                                x:Name="DataPager"
                                PageSize="250"
                                Source="{Binding Items, ElementName=gridView}"
                                IsTotalItemCountFixed="False"
                                DisplayMode="All, All"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Margin="5 0 0 0" Content="К-сть на сторінку:"/>

                    <TextBox Text="{Binding ElementName=DataPager, Path=PageSize, Mode=TwoWay, StringFormat='{}{0:N0}'}"
                                         VerticalContentAlignment="Center"
                                         MaxLength="5"
                                         HorizontalContentAlignment="Right"
                                         MinWidth="50"
                                         Margin="3"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Margin="10 0" Content="К-сть записів:"/>
                    <Label Margin="0 0 10 0" Content="{Binding ElementName=DataPager, Path=ItemCount}"/>
                </StackPanel>
            </Grid>

        </Grid>
    </t:RadBusyIndicator>
</UserControl>
