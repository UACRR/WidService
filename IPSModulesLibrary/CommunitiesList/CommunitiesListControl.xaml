<UserControl x:Class="IPSModulesLibrary.CommunitiesList.CommunitiesListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.CommunitiesList"
             xmlns:search="clr-namespace:IPSViewComponentLibraryWPF.Controls.SearchControl;assembly=IPSViewComponentLibraryWPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             Background="WhiteSmoke"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style TargetType="t:RadGridView">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="ShowGroupPanel" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ShowSearchPanel" Value="True"/>
            <Setter Property="SearchPanelCloseButtonVisibility" Value="Collapsed"/>
        </Style>
    </Control.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <search:SearchControl/>

        <Grid Grid.Row="1" Margin="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

          

            <t:RadGridView Grid.Row="2"
                           x:Name="gridView"
                           ItemsSource="{Binding ObjectsRightsItemSource}"
                           Margin="3">
                <t:RadGridView.Columns>
                    <t:GridViewDataColumn Width="75" Header="ID" DataMemberBinding="{Binding}"/>
                    <t:GridViewColumn Width="25">
                        <t:GridViewColumn.Header>
                            <Image Width="20" Height="20" Source="../Resources/Icons/edit-icon.png"/>
                        </t:GridViewColumn.Header>
                        <t:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <t:RadButton Margin="0" Width="25" Height="20" 
                                                     Command="{Binding DataContext.OpenObjectRightCommand, RelativeSource={RelativeSource AncestorType={x:Type t:RadGridView}}}"
                                                     CommandParameter="{Binding}">
                                    <Image Source="../Resources/Icons/edit-icon.png"/>
                                </t:RadButton>
                            </DataTemplate>
                        </t:GridViewColumn.CellTemplate>
                    </t:GridViewColumn>
                </t:RadGridView.Columns>
            </t:RadGridView>
            <t:RadDataPager Grid.Row="3"
                                    t:StyleManager.Theme="VisualStudio2013"
                                    PageSize="250"
                                    Source="{Binding Items, ElementName=gridView}"
                                    IsTotalItemCountFixed="False"
                                    DisplayMode="All, All"/>
        </Grid>
        <StackPanel Grid.Row="2" Background="Silver" Orientation="Horizontal">
            <Button HorizontalAlignment="Right"
                    Content="Додати нове товариство"
                    t:StyleManager.Theme="VisualStudio2013"
                    Margin="3"/>
        </StackPanel>
    </Grid>
</UserControl>
