<UserControl x:Class="IPSModulesLibrary.CommunitiesList.CommunitiesListControl"
             x:Name="thisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.CommunitiesList"
             xmlns:search="clr-namespace:IPSViewComponentLibraryWPF.Controls.SearchControl;assembly=IPSViewComponentLibraryWPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             Background="WhiteSmoke"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Control.DataContext>
        <local:CommunitiesListViewModel/>
    </Control.DataContext>

    <Control.Resources>
        <Style TargetType="t:RadGridView">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
            <Setter Property="ShowGroupPanel" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ShowSearchPanel" Value="True"/>
            <Setter Property="SearchPanelCloseButtonVisibility" Value="Collapsed"/>
        </Style>
        <Style TargetType="t:GridViewDataColumn">
            <Setter Property="HeaderTextAlignment" Value="Center"/>
            <Setter Property="IsFilterable" Value="False"/>
            <Setter Property="ShowToolTipOnTrimmedText" Value="True"/>
            <Setter Property="HeaderTextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="t:RadExpander">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>
        <Style TargetType="t:RadButton">
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style>
    </Control.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding ElementName=thisControl}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <t:RadBusyIndicator IsBusy="{Binding IsBusy}"
                        t:StyleManager.Theme="VisualStudio2013">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <search:SearchControl Grid.Row="0" x:Name="searchControl"/>

            <Grid Grid.Row="1" Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <t:RadGridView Grid.Row="0"
                               ColumnWidth="*"
                               x:Name="gridView"
                               ItemsSource="{Binding ObjectsRightsItemSource}">
                    <t:RadGridView.Columns>
                        <t:GridViewDataColumn Width="75" Header="ID" DataMemberBinding="{Binding CustId}"/>
                        <t:GridViewDataColumn Width="75" Header="{Binding LOC.GV_IN_CODE}" DataMemberBinding="{Binding InnerCode}"/>
                        <t:GridViewDataColumn Width="75" Header="SOC CODE"
                                              TextAlignment="Center"
                                              DataMemberBinding="{Binding InterCode}"/>
                        <t:GridViewDataColumn Header="{Binding LOC.GV_COMMUNITY_NAME}" DataMemberBinding="{Binding Name}"/>
                        <t:GridViewDataColumn Width="75" Header="{Binding LOC.GV_COMM_REG_DATE}" 
                                              DataFormatString="{}{0:d}"
                                              TextAlignment="Center"
                                              DataMemberBinding="{Binding RegistrDate}"/>
                        <t:GridViewDataColumn Width="75" Header="{Binding LOC.GV_AUTH_COUNT}"
                                              TextAlignment="Right"
                                              DataMemberBinding="{Binding CountAuthors}"/>
                        <t:GridViewColumn Width="25">
                            <t:GridViewColumn.Header>
                                <Image Width="20" Height="20" Source="../Resources/Icons/edit-icon.png"/>
                            </t:GridViewColumn.Header>
                            <t:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <t:RadButton Margin="0" Width="25" Height="20" 
                                                 Command="{Binding DataContext.OpenCommunityCommand, RelativeSource={RelativeSource AncestorType={x:Type t:RadGridView}}}"
                                                 CommandParameter="{Binding}">
                                        <Image Source="../Resources/Icons/edit-icon.png"/>
                                    </t:RadButton>
                                </DataTemplate>
                            </t:GridViewColumn.CellTemplate>
                        </t:GridViewColumn>
                    </t:RadGridView.Columns>
                </t:RadGridView>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <t:RadDataPager Grid.Column="0"
                                    Margin="3 0"
                                    BorderThickness="0"
                                    x:Name="DataPager"
                                    t:StyleManager.Theme="VisualStudio2013"
                                    PageSize="250"
                                    Source="{Binding Items, ElementName=gridView}"
                                    IsTotalItemCountFixed="False"
                                    DisplayMode="All, All"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Margin="5 0 0 0" Content="К-сть на сторінку:"/>

                        <TextBox Text="{Binding ElementName=DataPager, Path=PageSize, Mode=TwoWay, StringFormat='{}{0:N0}'}"
                                 VerticalContentAlignment="Center"
                                 MaxLength="5"
                                 HorizontalContentAlignment="Right"
                                 MinWidth="50"
                                 Margin="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Margin="10 0" Content="К-сть записів:"/>
                        <Label Margin="0 0 10 0" Content="{Binding ElementName=DataPager, Path=ItemCount}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2" Background="Silver" Orientation="Horizontal">
                <t:RadButton HorizontalAlignment="Right"
                             Content="{Binding LOC.BTN_CREATE_COMMUNITY}"
                             Margin="3"
                             Command="{Binding CreateCommunityCommand}"/>
            </StackPanel>
        </Grid>
    </t:RadBusyIndicator>
</UserControl>
