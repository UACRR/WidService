<UserControl x:Class="IPSModulesLibrary.PartnerList.PartnerListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.PartnerList"
             xmlns:search="clr-namespace:IPSViewComponentLibraryWPF.Controls.SearchControl;assembly=IPSViewComponentLibraryWPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             Background="WhiteSmoke"
             d:DesignHeight="450" d:DesignWidth="800">

    <Control.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/GridViewResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/StyleManagerResoureDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/DropDownButtonResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/TreeViewItemResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/ButtonsResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="t:RadDropDownButton">
                <Setter Property="Background" Value="#470fa9"/>
                <Setter Property="MinHeight" Value="33.5"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="8 3 5 8"/>
                <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">

                        <Setter Property="Background" Value="#32077d"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Trigger>

                </Style.Triggers>
            </Style>
        </ResourceDictionary>

    </Control.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding ElementName=thisControl}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <t:RadBusyIndicator IsBusy="{Binding IsBusy}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <t:RadTreeView Grid.Row="1" 
                               MinWidth="200" 
                               Margin="5">
                    <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" 
                                       IsSelected="True"
                                       Header="Всі"/>

                    <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}"
                                       IsSelectable="False"
                                       Header="Активні" />

                    <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" 
                                       IsSelectable="False"
                                       Header="На акцепті"/>

                    <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" 
                                       IsSelectable="False"
                                       Header="Не підтверджені"/>

                </t:RadTreeView>
            </Grid>

            <GridSplitter Grid.Column="1" 
                              Margin="0,3,0,3"
                              HorizontalAlignment="Stretch"
                              Width="3" Background="Silver" ShowsPreview="False"/>

            <Grid Grid.Column="2" Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <search:SearchControl Grid.Row="0" x:Name="searchControl"/>

                <t:RadGridView Grid.Row="1"
                                   x:Name="gridView"
                                   ColumnWidth="*"
                                   Margin="3">
                    <t:RadGridView.Columns>
                        <t:GridViewDataColumn Width="75" 
                                              Header="ID договору" 
                                              TextAlignment="Center"
                                              
                                              />
                        <t:GridViewDataColumn Width="75" 
                                              Header="ОКПОЛД"
                                              TextAlignment="Center"
                                              
                                              />
                        <t:GridViewDataColumn Width="75" 
                                              Header="Співробітник компанії"
                                              TextAlignment="Center"
                                              
                                              />
                        <t:GridViewDataColumn 
                                              Header="Представник"
                                              TextAlignment="Center"
                                              />
                        <t:GridViewDataColumn Width="75" 
                                              Header="№ договору"
                                              TextAlignment="Center"
                                              />
                        <t:GridViewDataColumn Width="75" 
                                              Header="Дата договору" 
                                              TextAlignment="Center" 
                                              />
                        <t:GridViewDataColumn 
                                              Header="Місто реєстрації" 
                                              TextAlignment="Center" 
                                              />
                        <t:GridViewDataColumn Width="100" 
                                              Header="Статус договору" 
                                              TextAlignment="Center"
                                              />
                        <t:GridViewDataColumn Width="75" 
                                              Header="К-сть договорів (всі/активні)" 
                                              TextAlignment="Center"
                                              />
                        <t:GridViewDataColumn Width="75" 
                                              Header="К-сть користувачів" 
                                              TextAlignment="Center"
                                              />
                        <t:GridViewColumn Width="25">
                            <t:GridViewColumn.Header>
                                <Image Width="20" Height="20" Source="../Resources/Icons/edit-icon.png"/>
                            </t:GridViewColumn.Header>
                            <t:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <t:RadButton Margin="0" Width="25" Height="20" 
                                                 Command="{Binding DataContext.OpenClientCommand, RelativeSource={RelativeSource AncestorType={x:Type t:RadGridView}}}"
                                                 CommandParameter="{Binding}">
                                        <Image Source="../Resources/Icons/edit-icon.png"/>
                                    </t:RadButton>
                                </DataTemplate>
                            </t:GridViewColumn.CellTemplate>
                        </t:GridViewColumn>
                    </t:RadGridView.Columns>
                </t:RadGridView>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <t:RadDataPager Grid.Column="0"
                                        Margin="3 0"
                                        BorderThickness="0"
                                        x:Name="DataPager"
                                        t:StyleManager.Theme="VisualStudio2013"
                                        PageSize="250"
                                        Source="{Binding Items, ElementName=gridView}"
                                        IsTotalItemCountFixed="False"
                                        DisplayMode="All, All"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Margin="5 0 0 0" Content="К-сть на сторінку:"/>

                        <TextBox Text="{Binding ElementName=DataPager, Path=PageSize, Mode=TwoWay, StringFormat='{}{0:N0}'}"
                                     VerticalContentAlignment="Center"
                                     MaxLength="5"
                                     HorizontalContentAlignment="Right"
                                     MinWidth="50"
                                     Margin="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Margin="10 0" Content="К-сть записів:"/>
                        <Label Margin="0 0 10 0" Content="{Binding ElementName=DataPager, Path=ItemCount}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3">
                    <t:RadDropDownButton HorizontalAlignment="Left"
                                         Content="Створити нового представника"
                                         MinWidth="175"
                                         CloseOnPopupMouseLeftButtonUp="True"
                                         Template="{DynamicResource RadDropDownButtonControlTemplate1}"
                                         Margin="3">

                    </t:RadDropDownButton>
                </Grid>
            </Grid>


        </Grid>
    </t:RadBusyIndicator>
</UserControl>
