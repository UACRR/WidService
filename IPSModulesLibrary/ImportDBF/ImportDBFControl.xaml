<UserControl x:Class="IPSModulesLibrary.ImportDBF.ImportDBFControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.ImportDBF"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             Background="WhiteSmoke"
             d:DesignHeight="450" d:DesignWidth="800">

    <Control.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/GridViewResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/StyleManagerResoureDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/DropDownButtonResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/TreeViewItemResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/ButtonsResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TabItem">
                <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="Border" BorderThickness="1,1,1,1 " CornerRadius="0,0,0,0"
                        Padding="25,10,25,10" Margin="0,0,0,0" BorderBrush="Gainsboro">
                                <ContentPresenter x:Name="ContentSite" ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="White"/>
                                    <Setter TargetName="Border" Property="Background" Value="#470fa9"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="Black"/>
                                    <Setter TargetName="Border" Property="Background" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="t:RadButton">
                <Setter Property="Background" Value="#470fa9"/>
                <Setter Property="MinHeight" Value="33.5"/>
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="8 3 5 8"/>
                <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="#470fa9" BorderBrush="#470fa9" BorderThickness="0,1,1,0" >
                                <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Background="#32077d" BorderBrush="#32077d" BorderThickness="0,1,1,0" >
                                        <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="#32077d"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Background="#1c0347" BorderBrush="#1c0347" BorderThickness="0,1,1,0" >
                                        <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TextBlock" x:Key="StatusText">
                <Setter Property="Background" Value="#b8b8b8"></Setter>

            </Style>
            <Style x:Key="categoryStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#f5f5f5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="textBlockButtons" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </Control.Resources>
    <Grid>
        <Grid Margin="20 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 20 0 10">
                <TextBlock Text="Дані по обраному платежу: "></TextBlock>
            </Grid>

            <Grid Grid.Row="1" Margin="0 7 0 0">
                <WrapPanel>
                    <TextBlock VerticalAlignment="Center" Text="- ЄДРПОУ:"></TextBlock>
                    <TextBox  Margin="20 0 0 0" Width="auto" Padding="2 1" IsReadOnly="True">afdsfsgsg</TextBox>
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0 7 0 0">
                <WrapPanel>
                    <TextBlock VerticalAlignment="Center" Text="- Назва користувача:"></TextBlock>
                    <TextBox  Margin="20 0 0 0" Width="auto" Padding="2  1" IsReadOnly="True">afdsfsgsg</TextBox>
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0 7 0 0">
                <WrapPanel>
                    <TextBlock VerticalAlignment="Center" Text="- Призначення платежу:"></TextBlock>
                    <TextBox  Margin="20 0 0 0" Width="auto" Padding="2 1" IsReadOnly="True">afdsfsgsg</TextBox>
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="0 10">
                <WrapPanel>
                    <TextBox Height="33.5" Margin="0 0 10 0" Width="380"></TextBox>
                    <t:RadButton Margin="8 0 0 0"
                                             Content="Пошук" 
                                             MinWidth="100" Padding="5,5,5,9" UseLayoutRounding="True"/>
                </WrapPanel>
            </Grid>

            <t:RadGridView Grid.Row="5"
                               ColumnWidth="*"
                               Margin="0 5 0 10">
                <t:RadGridView.Columns>
                    <t:GridViewDataColumn Width="100"
                                          Header="ЭДРПОУ" />

                    <t:GridViewDataColumn Header="Назва користувача"/>

                </t:RadGridView.Columns>
            </t:RadGridView>
        </Grid>
    </Grid>
</UserControl>
