<UserControl x:Class="IPSModulesLibrary.RoyaltyCorrection.RoyaltyCorrectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:IPSModulesLibrary.RoyaltyCorrection"
             Background="WhiteSmoke"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <local:RoyaltyCorrectionViewModel/>
    </UserControl.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Control.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/GridViewResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/StyleManagerResoureDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/ButtonsResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/TabControlResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="Gray"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Control.Resources>

    <t:RadBusyIndicator IsBusy="{Binding IsBusy}" t:StyleManager.Theme="VisualStudio2013">
        <TabControl>
            <TabItem Header="Исправление ошибочно начисленных роялти">
                <Grid MaxWidth="720" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0 20 0 10">
                        <TextBlock TextAlignment="Center" FontWeight="Bold" Text="Исправление ошибочно начисленных роялти "></TextBlock>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0 10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Margin="0 0 10 0" TextWrapping="Wrap" 
                                       MaxWidth="120" Text="Введите код объекта"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Margin="10 0 10 0" 
                                     Height="25"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ObjectRightID, TargetNullValue=''}"/>

                            <TextBlock Grid.Column="2" Margin="10 0 10 0" TextWrapping="Wrap" 
                                       MaxWidth="120" Text="Введите код ошибочн.правообл."
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3"
                                     Margin="10 0 10 0" 
                                     Height="25"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding RightholderID}"/>

                            <t:RadButton Grid.Column="4"
                                         Margin="8 0 0 0"
                                         Content="Знайти" 
                                         MinWidth="100" 
                                         Padding="5,5,5,9" 
                                         UseLayoutRounding="True"
                                         Command="{Binding SearchObjectCommand}"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Margin="0 0 10 0" 
                                   MaxWidth="120" Text="Название Объекта"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 MinHeight="25"
                                 Height="auto"
                                 Margin="10 0 10 0" 
                                 TextWrapping="Wrap" 
                                 VerticalAlignment="Center" 
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Text="{Binding ObjectRightName}"/>

                        <TextBlock Grid.Column="2" Margin="10 0 10 0" 
                                   MaxWidth="120" Text="Правообладатель"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="3" MinHeight="25"
                                 Height="auto"
                                 Margin="10 0 10 0" 
                                 VerticalAlignment="Center" 
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap" 
                                 IsReadOnly="True"
                                 Text="{Binding RightholderName}"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0 0 10 0">
                        <TextBlock  TextWrapping="Wrap" 
                                    Text="Укажите, по каким типам прав необходимо сделать исправления"
                                    VerticalAlignment="Center"/>
                    </Grid>

                    <t:RadGridView Grid.Row="4" ShowSearchPanel="False"
                                   x:Name="gridView"
                                   ColumnWidth="*"
                                   Margin="0 5 10 10"
                                   ItemsSource="{Binding CopyrightTypesItemSource}">
                        <t:RadGridView.Columns>

                            <t:GridViewDataColumn Header="Тип права" 
                                                  IsReadOnly="True"
                                                  DataMemberBinding="{Binding TypeName}"/>

                            <t:GridViewDataColumn Width="75"
                                                  IsReadOnly="True"
                                                  Header="%"
                                                  TextAlignment="Right"
                                                  DataMemberBinding="{Binding Rate, StringFormat='{}{0:N2}'}"/>

                            <t:GridViewDataColumn Width="100" 
                                                  IsReadOnly="True"
                                                  Header="Определенная сумма"
                                                  TextAlignment="Right"
                                                  DataMemberBinding="{Binding Amount, StringFormat='{}{0:N2}'}"/>

                            <t:GridViewCheckBoxColumn Width="40"
                                                      IsSortable="False"
                                                      EditTriggers="CellClick"
                                                      IsFilterable="False"
                                                      AutoSelectOnEdit="True"
                                                      Header=""
                                                      TextAlignment="Center"
                                                      IsThreeState="False"
                                                      DataMemberBinding="{Binding IsSelected, Mode=TwoWay}">
                                <t:GridViewCheckBoxColumn.CellStyle>
                                    <Style TargetType="t:GridViewCell">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </t:GridViewCheckBoxColumn.CellStyle>
                            </t:GridViewCheckBoxColumn>
                        </t:RadGridView.Columns>
                    </t:RadGridView>

                    <Grid Grid.Row="5" Margin="0 10" HorizontalAlignment="Right">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0 0 10 0"
                                           Text="Введите код правильного правообладателя"
                                           VerticalAlignment="Center"/>
                                <TextBox Height="25" 
                                         VerticalContentAlignment="Center" 
                                         Margin="10 0 10 0" 
                                         Width="100" Text="{Binding NewRightholderID}"/> 
                            </StackPanel>
                            <t:RadButton Margin="8 0 0 0"
                                         Content="Знайти" 
                                         MinWidth="100" 
                                         Padding="5,5,5,9" 
                                         UseLayoutRounding="True"
                                         Command="{Binding SearchRightholderCommand}"/>
                        </WrapPanel>
                    </Grid>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock TextWrapping="Wrap" 
                                   MaxWidth="120" Text="Правообладатель"
                                   VerticalAlignment="Center"/>
                        <TextBox Height="auto" 
                                 MinHeight="25" 
                                 Margin="10 0" 
                                 Width="200" 
                                 VerticalAlignment="Center" 
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap" 
                                 IsReadOnly="True" 
                                 Text="{Binding NewRightholderName}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="7" Margin="0 50 0 0">
                        <t:RadButton HorizontalAlignment="Right"
                                     Content="Виконати" 
                                     MinWidth="100" Padding="5,5,5,9" Margin="0 0 20 0" UseLayoutRounding="True"
                                     Command="{Binding RunCorrectionProcessCommand}"/>

                        <t:RadButton HorizontalAlignment="Right"
                                     Content="Очистити" 
                                     MinWidth="100" Padding="5,5,5,9" UseLayoutRounding="True"
                                     Command="{Binding ClearCommand}"/>
                    </StackPanel>
                </Grid>

            </TabItem>
        </TabControl>
    </t:RadBusyIndicator>
</UserControl>
