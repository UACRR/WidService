<UserControl x:Class="IPSModulesLibrary.FinishingWorks.FinishingWorksControl"
             x:Name="thisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.FinishingWorks"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             Background="WhiteSmoke"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/GridViewResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/StyleManagerResoureDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/DropDownButtonResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/TreeViewItemResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/ButtonsResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TabItem">
                <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="Border" BorderThickness="1,1,1,1 " CornerRadius="0,0,0,0"
                        Padding="25,10,25,10" Margin="0,0,0,0" BorderBrush="Gainsboro">
                                <ContentPresenter x:Name="ContentSite" ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="White"/>
                                    <Setter TargetName="Border" Property="Background" Value="#470fa9"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="Black"/>
                                    <Setter TargetName="Border" Property="Background" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="t:RadButton">
                <Setter Property="Background" Value="#470fa9"/>
                <Setter Property="MinHeight" Value="33.5"/>
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="8 3 5 8"/>
                <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="#470fa9" BorderBrush="#470fa9" BorderThickness="0,1,1,0" >
                                <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Background="#32077d" BorderBrush="#32077d" BorderThickness="0,1,1,0" >
                                        <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="#32077d"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Background="#1c0347" BorderBrush="#1c0347" BorderThickness="0,1,1,0" >
                                        <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TextBlock" x:Key="StatusText">
                <Setter Property="Background" Value="#b8b8b8"></Setter>

            </Style>
            <Style x:Key="categoryStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#f5f5f5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="textBlockButtons" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </Control.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Главное">
                <StackPanel MaxWidth="500">
                    <Grid Margin="0 20 0 10">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="250" Text="Статус работы комплекса:"/>

                        <Grid HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="44*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle RadiusX="5" RadiusY="5" 
                                       Width="{Binding Width,ElementName=textBlock}" 
                                       Height="33.5" 
                                       Stroke="#b8b8b8" Fill="#b8b8b8" StrokeThickness="3" 
                                       VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                            <TextBlock Name="textBlock" Padding="10,0, 10, 2" 
                                       Text="Происходит автоматическое распределение"
                                       Width="Auto" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                        </Grid>

                    </Grid>
                    <Grid Margin="0 10 0 10">
                        <TextBlock MaxWidth="230" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left">Введите дату и время остановки автоматического распределения и подтвердите установку:</TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <t:RadDateTimePicker Height="33.5" Margin="10 0 10 0" MinWidth="100"></t:RadDateTimePicker>
                            <t:RadButton HorizontalAlignment="Right"
                                         Margin="10 0 0 0"
                                         Height="33.5"
                                         Content="Подтвердить" 
                                         MinWidth="100" Padding="5,5,5,9" UseLayoutRounding="True"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0 10 0 10">
                        <TextBlock MaxWidth="230" VerticalAlignment="Center" HorizontalAlignment="Left">Внимание! Установлена дата остановки:</TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" Margin="10 0 10 0">__.__.____ __:__</TextBlock>
                            <t:RadButton HorizontalAlignment="Left"
                                         Content="Отменить" 
                                         MinWidth="100" Padding="5,5,5,9" Margin="10 0 0 0" UseLayoutRounding="True"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0 50 0 0">
                        <t:RadButton HorizontalAlignment="Left"
                                         Content="Окончательное зачисление" 
                                         MinWidth="100" Padding="5,5,5,9" UseLayoutRounding="True"/>

                        <t:RadButton HorizontalAlignment="Right"
                                         Content="Откат" 
                                         MinWidth="100" Padding="5,5,5,9" UseLayoutRounding="True"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Документы">
                <WrapPanel ItemHeight="280" ItemWidth="280" Orientation="Horizontal"  HorizontalAlignment="Center" Margin="0, 20">
                    <Border Style="{StaticResource categoryStyle}" Margin="25" CornerRadius="10"  Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.3"></DropShadowEffect>
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCategoryCommand}" CommandParameter="all"/>
                        </Border.InputBindings>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="ВІДОМІСТЬ 'РОЗПОДІЛ АВТОРСЬКОЇ ВИНАГОРОДИ НА ПРАВОВЛАСНИКІВ З 'МАЛИХ ПРАВ'"
                                       Style="{StaticResource textBlockButtons}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource categoryStyle}" Margin="25" CornerRadius="10"  Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.3"></DropShadowEffect>
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCategoryCommand}" CommandParameter="all"/>
                        </Border.InputBindings>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="ВІДОМІСТЬ 'РОЗПОДІЛ АВТОРСЬКОЇ ВИНАГОРОДИ НА ПРАВОВЛАСНИКІВ З 'ВЕЛИКИХ ПРАВ'"
                                       Style="{StaticResource textBlockButtons}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </WrapPanel>
            </TabItem>

            <TabItem Header="Получение средств праввообладателями">
                <WrapPanel  ItemHeight="280" ItemWidth="280" Orientation="Horizontal"  HorizontalAlignment="Center" Margin="0, 20">
                    <Border Style="{StaticResource categoryStyle}" Margin="25" CornerRadius="10"  Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.3"></DropShadowEffect>
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCategoryCommand}" CommandParameter="all"/>
                        </Border.InputBindings>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Разбор принятых '.dbf' по оплате роялти правообладателями"
                                       Style="{StaticResource textBlockButtons}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource categoryStyle}" Margin="25" CornerRadius="10"  Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.3"></DropShadowEffect>
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCategoryCommand}" CommandParameter="all"/>
                        </Border.InputBindings>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Ручной ввод снятия роялти правообладателями"
                                       Style="{StaticResource textBlockButtons}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </WrapPanel>
            </TabItem>

            <TabItem Header="Исправления">
                <Grid>
                    <WrapPanel ItemHeight="280" ItemWidth="280" Orientation="Horizontal"  HorizontalAlignment="Center" Margin="0, 20" Visibility="Hidden">

                        <Border Style="{StaticResource categoryStyle}" Margin="25" CornerRadius="10"  Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.3"></DropShadowEffect>
                            </Border.Effect>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCategoryCommand}" CommandParameter="all"/>
                            </Border.InputBindings>
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Исправление ошибочно начисленных роялти "
                                           Style="{StaticResource textBlockButtons}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </WrapPanel>
                    <Grid MaxWidth="500">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0 20 0 10">
                            <TextBlock TextAlignment="Center" FontWeight="Bold" Text="Исправление ошибочно начисленных роялти "></TextBlock>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0 10">
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0 0 10 0" TextWrapping="Wrap" 
                                               MaxWidth="120" Text="Введите код объекта"
                                               VerticalAlignment="Center"></TextBlock>
                                    <TextBox Height="33.5" Margin="10 0 10 0" Width="50"></TextBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="10 0 10 0" TextWrapping="Wrap" 
                                               MaxWidth="120" Text="Введите код ошибочн.правообл."
                                               VerticalAlignment="Center"></TextBlock>
                                    <TextBox Height="33.5" Margin="10 0 10 0" Width="50"></TextBox>
                                </StackPanel>
                                <t:RadButton Margin="8 0 0 0"
                                             Content="Знайти" 
                                             MinWidth="100" Padding="5,5,5,9" UseLayoutRounding="True"/>
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0 10">
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0 0 10 0" TextWrapping="Wrap" 
                                               MaxWidth="120" Text="Название Объекта"
                                               VerticalAlignment="Center"></TextBlock>
                                    <TextBox Height="20" Margin="10 0 10 0" Width="100" IsReadOnly="True">Название</TextBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="10 0 10 0" TextWrapping="Wrap" 
                                               MaxWidth="120" Text="Правообладатель"
                                               VerticalAlignment="Center"></TextBlock>
                                    <TextBox Height="20" Margin="10 0 10 0" Width="100" IsReadOnly="True">Название</TextBox>
                                </StackPanel>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
