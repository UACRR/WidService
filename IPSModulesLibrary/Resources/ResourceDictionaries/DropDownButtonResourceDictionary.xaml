<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="t:RadDropDownButton">
        <Style.Setters>
            <!--<Setter Property="Background" Value="#470fa9"/>-->
            <!--<Setter Property="MinHeight" Value="33.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8 3 5 8"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>-->
            <Setter Property="t:StyleManager.Theme" Value="VisualStudio2013"/>
        </Style.Setters>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True" >
                <Setter Property="Background" Value="#32077d"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>