<UserControl x:Class="IPSModulesLibrary.ClientSRList.ClientSRListControl"
             x:Name="thisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.ClientSRList"
             xmlns:search="clr-namespace:IPSViewComponentLibraryWPF.Controls.SearchControl;assembly=IPSViewComponentLibraryWPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             Background="WhiteSmoke"
             d:DesignHeight="450" d:DesignWidth="800">

    <Control.DataContext>
        <local:ClientSRListViewModel/>
    </Control.DataContext>

    <Control.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/GridViewResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/StyleManagerResoureDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/DropDownButtonResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/TreeViewItemResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/ResourceDictionaries/ButtonsResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Control.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding ElementName=thisControl}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <t:RadBusyIndicator IsBusy="{Binding IsBusy}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Фільтр реєстру" Margin="3" FontWeight="SemiBold"/>

                <t:RadTreeView Grid.Row="1" 
                               MinWidth="200" 
                               SelectedItem="{Binding SelectedTreeViewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Margin="5">
                    <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" IsExpanded="True" FontWeight="Bold"
                                       IsSelected="True"
                                       Header="* всі"/>
                    
                    <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" IsExpanded="True" FontWeight="Bold"
                                       IsSelectable="False"
                                       Header="* по статусу договорів">
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="statusActive"
                                           Header="Діючі"/>
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="statusForAccept"
                                           Header="Не підтверджені" />
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="statusNoAccept"
                                           Header="На акцепті" />
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="statusProlong"
                                           Header="Для пролонгації" />
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="statusClose"
                                           Header="Закриті" />
                    </t:RadTreeViewItem>

                    <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" IsExpanded="True" FontWeight="Bold"
                                       IsSelectable="False"
                                       Header="* по стану обліку коштів" >
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="statusUnattach"
                                           Header="Незакріплені" />
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="statusUndistribute"
                                           Header="Нерозподіленні" />
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="statusBorg"
                                           Header="Борг" />
                    </t:RadTreeViewItem>
                    
                    <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" IsExpanded="True" FontWeight="Bold"
                                       IsSelectable="False"
                                       Header="* по статусу звітніх періодів" >
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="statusNoMoney"
                                           Header="Прийом коштів"/>
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="statusNoReport"
                                           Header="Прийом звітів" />
                    </t:RadTreeViewItem>

                    <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" IsExpanded="True" FontWeight="Bold" 
                                       IsSelectable="False"
                                       Header="* по статусу звітів">
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"  
                                           Name="rgStatusOk"
                                           Header="Погоджені звіти"/>
                        <t:RadTreeViewItem Template="{StaticResource TreeViewItemTemplate}" FontWeight="Normal"
                                           Name="rgStatusRefuse"
                                           Header="Відхилені звіти"/>
                    </t:RadTreeViewItem>
                </t:RadTreeView>
            </Grid>

            <GridSplitter Grid.Column="1" 
                              Margin="0,3,0,3"
                              HorizontalAlignment="Stretch"
                              Width="3" Background="Silver" ShowsPreview="False"/>

            <Grid Grid.Column="2" Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <search:SearchControl Grid.Row="0" x:Name="searchControl"/>

                <t:RadGridView Grid.Row="1"
                                   x:Name="gridView"
                                   ColumnWidth="*"
                                   ItemsSource="{Binding ClientsSRItemSource}"
                                   Margin="3">
                    <t:RadGridView.Columns>
                        <t:GridViewDataColumn Width="75" 
                                              Header="ID" 
                                              DataMemberBinding="{Binding CustId}"/>
                        <t:GridViewDataColumn Width="125" 
                                              Header="ЄДРПОУ"
                                              DataMemberBinding="{Binding INNOKPO}"/>
                        <t:GridViewDataColumn Header="Назва"
                                              DataMemberBinding="{Binding Name}"/>
                        <t:GridViewDataColumn Width="100" 
                                              Header="К-сть діючих договорів"
                                              TextAlignment="Center"
                                              DataMemberBinding="{Binding CountActive}"/>
                        <t:GridViewDataColumn Width="120" 
                                              Header="Незакріплені кошти"
                                              TextAlignment="Right"
                                              DataMemberBinding="{Binding UnattachAmount, StringFormat='{}{0:N2}'}"/>
                        <t:GridViewDataColumn Width="120" Header="Нерозподіленні кошти" 
                                              TextAlignment="Right" 
                                              DataMemberBinding="{Binding UndistribAmount, StringFormat='{}{0:N2}'}"/>
                        <t:GridViewDataColumn Width="120" Header="Борг" 
                                              TextAlignment="Right"
                                              DataMemberBinding="{Binding AmountBorg, StringFormat='{}{0:N2}'}"/>

                        <t:GridViewColumn Width="25">
                            <t:GridViewColumn.Header>
                                <Image Width="20" Height="20" Source="../Resources/Icons/edit-icon.png"/>
                            </t:GridViewColumn.Header>
                            <t:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <t:RadButton Margin="0" Width="25" Height="20" 
                                                 Command="{Binding DataContext.OpenClientCommand, RelativeSource={RelativeSource AncestorType={x:Type t:RadGridView}}}"
                                                 CommandParameter="{Binding}">
                                        <Image Source="../Resources/Icons/edit-icon.png"/>
                                    </t:RadButton>
                                </DataTemplate>
                            </t:GridViewColumn.CellTemplate>
                        </t:GridViewColumn>
                    </t:RadGridView.Columns>
                </t:RadGridView>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <t:RadDataPager Grid.Column="0"
                                        Margin="3 0"
                                        BorderThickness="0"
                                        x:Name="DataPager"
                                        t:StyleManager.Theme="VisualStudio2013"
                                        PageSize="250"
                                        Source="{Binding Items, ElementName=gridView}"
                                        IsTotalItemCountFixed="False"
                                        DisplayMode="All, All"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Margin="5 0 0 0" Content="К-сть на сторінку:"/>

                        <TextBox Text="{Binding ElementName=DataPager, Path=PageSize, Mode=TwoWay, StringFormat='{}{0:N0}'}"
                                     VerticalContentAlignment="Center"
                                     MaxLength="5"
                                     HorizontalContentAlignment="Right"
                                     MinWidth="50"
                                     Margin="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Margin="10 0" Content="К-сть записів:"/>
                        <Label Margin="0 0 10 0" Content="{Binding ElementName=DataPager, Path=ItemCount}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3">
                    <t:RadDropDownButton HorizontalAlignment="Left"
                                         Content="Новий користувач"
                                         MinWidth="175"
                                         CloseOnPopupMouseLeftButtonUp="True"
                                         Margin="3">
                        <t:RadDropDownButton.DropDownContent>
                            <StackPanel>
                                <t:RadButton Margin="0"
                                             MinWidth="140"
                                             Style="{StaticResource ddButton}"
                                             HorizontalContentAlignment="Left"
                                             Content="Фізична особа"
                                             Command="{Binding Create_P_ClientCommand}"/>
                                <t:RadButton Margin="0"
                                             MinWidth="140"
                                             Style="{StaticResource ddButton}"
                                             HorizontalContentAlignment="Left"
                                             Content="Юридична особа"
                                             Command="{Binding Create_J_ClientCommand}"/>
                            </StackPanel>
                        </t:RadDropDownButton.DropDownContent>
                    </t:RadDropDownButton>
                </Grid>
            </Grid>
          

        </Grid>
    </t:RadBusyIndicator>
</UserControl>
