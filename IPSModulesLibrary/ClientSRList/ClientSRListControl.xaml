<UserControl x:Class="IPSModulesLibrary.ClientSRList.ClientSRListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IPSModulesLibrary.ClientSRList"
             xmlns:search="clr-namespace:IPSViewComponentLibraryWPF.Controls.SearchControl;assembly=IPSViewComponentLibraryWPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             Background="WhiteSmoke"
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style TargetType="t:RadTreeViewItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#470fa9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Foreground" Value="#a0a0a0"/>

                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="t:RadDropDownButton">
            <Setter Property="Background" Value="#470fa9"/>
            <Setter Property="MinHeight" Value="33.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8 3 5 8"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#32077d"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>

            </Style.Triggers>
        </Style>
    </Control.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <t:RadTreeView MinWidth="200" Margin="5">
                <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" IsExpanded="True" Header="Договори:" FontWeight="Bold">
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Всі" FontWeight="Normal"/>
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Діючі" FontWeight="Normal"/>
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Не підтверджені" FontWeight="Normal"/>
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="На акцепті" FontWeight="Normal"/>
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Для пролонгації" FontWeight="Normal"/>
                </t:RadTreeViewItem>
                <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" IsExpanded="True" Header="Кошти:" FontWeight="Bold">
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Незакріплені" FontWeight="Normal"/>
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Нерозподіленні" FontWeight="Normal"/>
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Борг" FontWeight="Normal"/>
                </t:RadTreeViewItem>
                <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" IsExpanded="True" Header="Періоди:" FontWeight="Bold">
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Прийом коштів" FontWeight="Normal"/>
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Прийом звітів" FontWeight="Normal"/>
                </t:RadTreeViewItem>
                <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" IsExpanded="True" Header="Звіти:" FontWeight="Bold">
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Погоджені звіти" FontWeight="Normal"/>
                    <t:RadTreeViewItem Template="{StaticResource RadTreeViewItemControlTemplate1}" Header="Відхилені звіти" FontWeight="Normal"/>
                </t:RadTreeViewItem>
            </t:RadTreeView>

            <GridSplitter Grid.Column="1" 
                              Margin="0,3,0,3"
                              HorizontalAlignment="Stretch"
                              Width="3" Background="Silver" ShowsPreview="False"/>

            <Grid Grid.Column="2" Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <search:SearchControl Grid.Row="0" x:Name="searchControl"/>

                <t:RadGridView Grid.Row="1"
                                   x:Name="gridView"
                                   ColumnWidth="*"
                                   ItemsSource="{Binding ObjectsRightsItemSource}"
                                   Margin="3">
                    <t:RadGridView.Columns>
                        <t:GridViewDataColumn Width="50" Header="ЄДРПОУ" />
                        <t:GridViewDataColumn Header="Назва" />
                        <t:GridViewDataColumn Header="Бренд" />
                        <t:GridViewDataColumn Width="40" Header="К-сть діючих договорів" />
                        <t:GridViewDataColumn Width="75" Header="Незакріплені кошти" />
                        <t:GridViewDataColumn Width="75" Header="Нерозподіленні кошти" TextAlignment="Right" />
                        <t:GridViewDataColumn Width="75" Header="Борг" TextAlignment="Right" />

                        <t:GridViewColumn Width="25">
                            <t:GridViewColumn.Header>
                                <Image Width="15" Height="15" Source="../Resources/Icons/information.png"/>
                            </t:GridViewColumn.Header>
                            <t:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <t:RadButton Margin="0" Width="15" Height="15">
                                        <Image Source="../Resources/Icons/information.png"/>
                                    </t:RadButton>
                                </DataTemplate>
                            </t:GridViewColumn.CellTemplate>
                        </t:GridViewColumn>
                    </t:RadGridView.Columns>
                </t:RadGridView>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <t:RadDataPager Grid.Column="0"
                                        Margin="3 0"
                                        BorderThickness="0"
                                        x:Name="DataPager"
                                        t:StyleManager.Theme="VisualStudio2013"
                                        PageSize="250"
                                        Source="{Binding Items, ElementName=gridView}"
                                        IsTotalItemCountFixed="False"
                                        DisplayMode="All, All"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Margin="5 0 0 0" Content="К-сть на сторінку:"/>

                        <TextBox Text="{Binding ElementName=DataPager, Path=PageSize, Mode=TwoWay, StringFormat='{}{0:N0}'}"
                                     VerticalContentAlignment="Center"
                                     MaxLength="5"
                                     HorizontalContentAlignment="Right"
                                     MinWidth="50"
                                     Margin="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Margin="10 0" Content="К-сть записів:"/>
                        <Label Margin="0 0 10 0" Content="{Binding ElementName=DataPager, Path=ItemCount}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3">
                    <t:RadDropDownButton HorizontalAlignment="Right"
                                     Content="Новий користувач"
                                     CloseOnPopupMouseLeftButtonUp="True"
                                     Margin="3">
                        <t:RadDropDownButton.DropDownContent>
                            <StackPanel>
                                <t:RadButton Margin="0"
                                     MinWidth="120"
                                     HorizontalContentAlignment="Left"
                                     Content="{Binding LOC.BTN_RH_PHIS}"
                                     Command="{Binding CreateRHPhisCommand}"/>
                                <t:RadButton Margin="0" 
                                     MinWidth="120"
                                     HorizontalContentAlignment="Left"
                                     Content="{Binding LOC.BTN_RH_JUR}"
                                     Command="{Binding CreateRHJurCommand}"/>
                            </StackPanel>
                        </t:RadDropDownButton.DropDownContent>
                    </t:RadDropDownButton>
                </Grid>
            </Grid>
          

        </Grid>
    </Grid>
</UserControl>
